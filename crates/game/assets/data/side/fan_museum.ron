// The Ceiling Fan Museum (crates/side/src/features/fan_museum.rs): a load-in
// place. Its inside is stacked deep under its spot on the commune.
(
    // The interior's floor height (m). Keep it inside the `fan_museum` area's
    // height band in data/base/areas.ron.
    interior_floor: -95.0,
    // Stand this close (m) to the front doors (inside or out) and you go through.
    door_reach: 1.3,
)
