// Head-related 3D sound for world sounds (crates/base/src/spatial.rs).
// Headphones: a short filter per ear (the baked SADIE II KU100 head) lets you
// hear a sound above, below and behind you. Only the loudest few sounds get
// it; the rest use the cheaper left/right model. The player can switch it
// off in Settings.
(
    // Switch it off for everyone.
    enabled: true,
    // At most this many sounds are filtered at once (each costs ~100 multiplies
    // per sample per ear on the audio thread).
    max_hrtf: 12,
    // Seconds a sound takes to fade into or out of the filter.
    fade_secs: 0.12,
    // The room's echo: one shared reverb every world sound sends into. How
    // long it rings comes from the room you're in (outdoors, or Fulton St's
    // tiled halls: `echo_secs` in its data file); this is how it sounds.
    reverb: (
        // Milliseconds of quiet before the echo arrives, then how long it
        // takes to build up.
        predelay_ms: 12.0,
        attack_ms: 8.0,
        // Its top end at the start, and by the time it has died away (Hz):
        // a lower `dark_hz` is a duller, softer room.
        bright_hz: 5000.0,
        dark_hz: 900.0,
        // How loud the echo is (1 = as loud as it always was).
        level: 1.0,
    ),
)
