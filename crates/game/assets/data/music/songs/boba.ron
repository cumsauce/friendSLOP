#![enable(implicit_some)]
// Boba: song 1 (its own song, #356). See moods.ron for what the fields mean.
// "Pearls": the bubbly shop playlist in New York's boba places. Bouncy
// city-pop: kalimba plinks like tapioca, clav stabs, slap bass, a mini lead.
(
    mood: "Boba",
    bpm: 112.0, swing: 0.1, key: 5,
    a: "ROYAL_ROAD", b: "VILLAGE_B", hook: "JTTOU",
    groove: City, bass: ["SLAP1", "SLAP2"],
    comp: Stabs, lead: Mini, arp: Some(Kalimba), pad: true,
    intensity: 0.5, odd: 0.1, modulate: 0.3, kime: 0.3,
    theme: false, bass_inst: SlapBass, pad_inst: Pad,
    horns: Stabs, kit: (shaker: true, conga: false, clap: true, ride: false),
    answer: Some(Clav), nylon: None,
)
