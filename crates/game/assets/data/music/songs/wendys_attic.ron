#![enable(implicit_some)]
// WendysAttic: song 1 (its own song). See moods.ron for what the fields mean.
// "Who's Up There": the jingle's chords slowed and turned
// minor on warped tape. Vibes pick at it like a music box,
// the doo-wah singers hang far off, an organ holds, a pan flute
// drifts in, tabla swoops in the dark and a woodblock ticks.
(
    mood: "WendysAttic",
    bpm: 68.0, swing: 0.1, key: 7,
    a: "ATTIC_A", b: "ATTIC_B", hook: "ATTIC_HOOK",
    groove: Sparse, bass: ["PEDAL", "SPARSE"],
    comp: Long, lead: Flute, arp: Some(Vibes), pad: true,
    intensity: 0.25, odd: 0.0, modulate: 0.0, kime: 0.0,
    theme: false, bass_inst: Upright, pad_inst: Choir,
    horns: None, kit: (shaker: false, conga: true, clap: false, ride: false),
    answer: Some(PanFlute), nylon: None,
    keys: Some(Organ), hand: Some(Tabla), perc: [Woodblock],
)
