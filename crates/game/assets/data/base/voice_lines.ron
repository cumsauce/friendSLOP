// Tuning for voice lines (crates/base/src/features/voice_lines.rs).
// Edit and save: the running game picks it up within a second.
(
    music_box_count: 2,
    // Seconds between voice lines.
    line_period: 17.0,
    // How long a line stays on screen.
    line_shown: 4.5,
    syllable: 0.11,
)
