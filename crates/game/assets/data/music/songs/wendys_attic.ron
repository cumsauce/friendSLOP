#![enable(implicit_some)]
// WendysAttic: song 1 (its own song). See moods.ron for what the fields mean.
// "Who's Up There" (#324, written out): a music box gone wrong. Vibes
// pick a little riff over a harmonic-minor creep, an organ holds the
// chords, the upright creaks back to the root, a woodblock ticks like a
// clock nobody wound, and far-off voices double the tune a sixth below
// in the chorus.
(
    mood: "WendysAttic", band: "street",
    bpm: 64.0, swing: 0.1, key: 7,
    a: "CREEP_A", b: "CREEP_B", hook: "CREEP_HOOK",
    intensity: 0.3, odd: 0.0, modulate: 0.0, kime: 0.0,
    parts: [
        (play: Drums(groove: "Sparse")),
        (play: Lane(lane: "Woodblock"), not: [Intro]),
        (play: Bass(lines: ["CREEP", "PEDAL"]), inst: Upright, bus: "bass", layer: [((not: [Intro]), 0.7), ((above: 0.3), 0.7)]),
        (play: Chords(comp: "Long"), inst: Organ),
        (play: Melody(style: "riff"), inst: Vibes),
        (play: Harmony(steps: -5), inst: Choir, sections: [Hook]),
        (play: Pad(), inst: Choir, sections: [B, Breakdown]),
    ],
)
