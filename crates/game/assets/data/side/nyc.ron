// New York City (#283, crates/side/src/features/nyc.rs).
// Edit and save: the running game picks it up within a second.
(
    // The trail post at the valley's south edge (x, z).
    trail_post: (10.0, 86.0),
    // Where you arrive in the city (x, z), in the forest over the rim;
    // the way-back post stands beside it.
    arrival: (0.0, 125.0),
    // Where you come back to in the valley (x, z), beside the trail post.
    return_to: (10.0, 83.0),
    // Seed for the skyline (tower heights, cabs, trees).
    seed: 283,
    // The shops' names and the line shown when you step in:
    // bodega, pizza, laundromat, diner (in that order).
    shops: [
        ("Deli & Grocery", "the bodega cat is asleep on the bread. don't."),
        ("99¢ Fresh Pizza", "one slice, folded. that's the only way."),
        ("Suds City Laundromat", "every machine says OUT OF ORDER except the one with someone's socks in it."),
        ("Starlite Diner", "coffee's bottomless. the waitress calls you hon."),
    ],
    // Shown inside the Oculus.
    oculus_line: "PATH station: no trains running yet. one day they might go places.",
)
