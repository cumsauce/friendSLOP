// Tuning for gods tears (crates/story/src/features/gods_tears.rs).
// Edit and save: the running game picks it up within a second.
(
    // The whole, limited supply of tears. They all fall once, at the start.
    total_tears: 12,
    // Height a new tear falls from.
    fall_from: 12.0,
    // How fast it falls (units per second).
    fall_speed: 6.0,
)
