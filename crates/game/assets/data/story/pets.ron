// Tuning for pets (crates/story/src/features/pets.rs).
// Edit and save: the running game picks it up within a second.
(
    // Pets closer than this are connected.
    link_dist: 2.5,
    // How fast a pet trots after its owner.
    speed: 4.0,
    // Pets stop this short of the pointer.
    heel: 0.8,
    // Where the dog, cat, bunny and duck wait to be adopted, from the middle
    // of the "pets" site in data/base/sites.ron (x, z, metres).
    strays: [(-4.0, 4.0), (3.0, 8.0), (-9.0, 2.0), (7.0, -2.0)],
)
