        (stage: 10, name: "Median run", calm: false, points: [(3262.35, -922.30, -1928.50), (3271.04, -923.70, -1929.12), (3279.73, -925.11, -1929.75), (3288.42, -926.51, -1930.38), (3297.11, -927.92, -1931.00), (3305.81, -929.32, -1931.62), (3314.50, -930.73, -1932.25), (3323.19, -932.13, -1932.88), (3331.88, -933.54, -1933.50), (3340.57, -934.94, -1934.12), (3349.26, -936.34, -1934.75), (3357.95, -937.75, -1935.38), (3366.64, -939.15, -1936.00), (3375.34, -940.56, -1936.62), (3384.03, -941.96, -1937.25), (3392.72, -943.37, -1937.88), (3401.41, -944.77, -1938.50), (3410.10, -946.18, -1939.12), (3418.79, -947.58, -1939.75), (3427.48, -948.98, -1940.38), (3436.18, -950.39, -1941.00), (3442.59, -951.42, -1941.46)]),
