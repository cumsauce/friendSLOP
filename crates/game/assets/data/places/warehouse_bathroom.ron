// Tuning for warehouse bathroom (crates/places/src/features/warehouse/bathroom.rs).
// Edit and save: the running game picks it up within a second.
(
    // Chance an expedition's warehouse has a bathroom in it.
    chance: 0.65,
    // The fart monster's patrol and waddle speeds (walking is 5 m/s).
    patrol_speed: 1.4,
    waddle_speed: 2.6,
    // It notices you this close (down a clear aisle).
    notice: 6.0,
    // It gasses you this close.
    gas_reach: 1.5,
    // Seconds it stands there, satisfied, after gassing someone.
    smug: 4.0,
    // How many cells (5 m each) it spans each way: big enough to get lost
    // in, like the Backrooms. At most 5 (the warehouse is 7 x 7 and its
    // first two rows stay storage).
    min_cells: 3,
    max_cells: 5,
)
