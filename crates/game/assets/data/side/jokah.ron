// The Jokah (#377, crates/side-nyc/src/features/jokah.rs): a man who walks
// from Wendy's to the J station (the Fulton St entrance) laughing to himself,
// turns into a Michael Jackson impersonator there and walks back scatting and
// sliding. Edit and save: the running game picks it up within a second.
(
    // Where he stands out from Wendy's front door (x, z from the Wendy's spot).
    wendys_offset: (0.0, -6.5),
    // Where he stops by the J station (x, z from where you come up out of Fulton St).
    station_offset: (2.0, 1.5),
    // Points he walks through on the way to the station, in order (world x, z);
    // he walks them backwards on the way home.
    route: [(8.0, 150.0), (-8.0, 160.0)],
    // How close counts as reaching a point (m).
    arrive: 0.6,
    // Walking speed (m/s): as the Jokah, and as Michael.
    walk_speed: 1.3,
    mj_speed: 1.6,
    // Seconds he stands at each end before turning round.
    pause_secs: 3.0,
    // Seconds between laughs (min, max), and between scats.
    laugh_every: (4.0, 9.0),
    scat_every: (2.5, 5.0),
    // His three laughs: what the speech synth says, its pitch (Hz) and speed.
    laughs: [
        (text: "heh heh heh heh heh", pitch: 105.0, speed: 1.3),
        (text: "ha ha ha haaa ha ha haaaa", pitch: 150.0, speed: 1.0),
        (text: "hee hee hee hee hoo hoo hoo", pitch: 210.0, speed: 1.5),
    ],
    // Michael's scats (picked at random).
    scats: [
        "shamone",
        "hee hee",
        "dah dah dah shoo bee doo bop",
        "ow",
        "chika dah bop bop dah",
        "ba da ba dee ow",
    ],
    // Michael's voice (pitch Hz, speed, mood from data/base/speech.ron).
    scat_voice: (pitch: 230.0, speed: 1.4, mood: "excited"),
    // Michael's sound files (made in sounder). While this isn't empty he plays
    // only these (silent until one has loaded); the synth `scats` above are
    // used only if you empty it.
    clips: [
        "audio/sfx/mj_hee_hee_1.wav",
        "audio/sfx/mj_hee_hee_2.wav",
        "audio/sfx/mj_hee_hee_3.wav",
        "audio/sfx/mj_hee_hee_falsetto_1.ogg",
        "audio/sfx/mj_hee_hee_falsetto_2.ogg",
        "audio/sfx/mj_hee_hee_falsetto_3.ogg",
        "audio/sfx/mj_wa_1.wav",
        "audio/sfx/mj_wa_2.wav",
        "audio/sfx/mj_wow_1.wav",
        "audio/sfx/mj_wow_2.wav",
        "audio/sfx/mj_yeah_1.wav",
        "audio/sfx/mj_yeah_2.wav",
        "audio/sfx/mj_hoo_1.wav",
        "audio/sfx/mj_hoo_2.wav",
        "audio/sfx/mj_ow_1.wav",
        "audio/sfx/mj_ow_2.wav",
        "audio/sfx/mj_whoo_1.ogg",
        "audio/sfx/mj_whoo_2.ogg",
        "audio/sfx/mj_uh_1.ogg",
        "audio/sfx/mj_uh_2.ogg",
        "audio/sfx/mj_aah_1.ogg",
        "audio/sfx/mj_aah_2.ogg",
        "audio/sfx/mj_ee_hee_1.ogg",
        "audio/sfx/mj_ee_hee_2.ogg",
    ],
    // The Jokah's laughs as sound files (a dark laugh and a chuckle). While
    // this isn't empty he plays only these (silent until one has loaded); the
    // synth `laughs` above are used only if you empty it.
    laugh_clips: [
        "audio/sfx/jokah_dark_laugh_1.wav",
        "audio/sfx/jokah_dark_laugh_2.wav",
        "audio/sfx/jokah_dark_laugh_3.wav",
        "audio/sfx/jokah_chuckle_1.wav",
        "audio/sfx/jokah_chuckle_2.wav",
        "audio/sfx/jokah_chuckle_3.wav",
    ],
    // Walls and props: how wide a ball he feels his way with (m), and how long
    // (s) he may stand blocked before he walks on through.
    body_radius: 0.35,
    stuck_secs: 4.0,
    // Only heard this close (m), and how loud.
    hear_range: 40.0,
    volume: 0.9,
    // Michael's slides: seconds between them (min, max), how long one lasts (s)
    // and how fast he glides (m/s).
    slide_every: (3.0, 8.0),
    slide_secs: 1.4,
    slide_speed: 1.8,
)
