#![enable(implicit_some)]
// The soundtrack's score: its moods, where each one plays, and the progressions and bass
// lines the songs share (crates/fusion: the composer reads this, the synths stay in code).
// The songs themselves are one file each in songs/ (listed, in order, in songs.ron).
// Everything a song names (grooves, comps, chord qualities, lead styles, bands...) is in
// library.ron beside this file. Edit and save: the running
// game picks it up within a second, and `cargo run -p fusion --bin fusion-render -- help`
// renders a mood to listen to.
//
// progressions: (semitones above the key, chord quality, beats). Qualities are named in
//   library.ron's `qualities` (Maj9, Maj7s11, Maj69, Min9, Min11, Min6, MinMaj9, Dom13, Dom9,
//   Dom7s9, Dom7alt, Dom13s11, Dom7b9, Sus9, HalfDim, Dim7, and the plain Maj, Min,
//   MinHarm, Dom7, Dom7Phryg, Maj7, Min7, Power, Sus4, Add9, and by their place in the
//   key MajLyd, Maj7Lyd, MajMix, MinAeo, Min7Aeo; add more there).
// bass: one char per step (16 to a bar unless a song says): R root, P octave pop, G ghost
//   (dead note), 5/3/7 chord tones, A chromatic approach to the next chord, - hold, . rest.
// moods (in order): name, tone (warmth: + warm / - crisp, stereo width, tape wow 0..1,
//   backbeat lay-back and hat looseness in ms), level_db (make-up gain), optionally wet /
//   echo (the room's reverb and echo, 1 as mixed), and flags (all false unless written):
//   urgent (cuts in at the next bar line, no transition bar), instant (the director switches
//   to it at once instead of waiting 2 s to be sure), wandering (your running, idling and
//   friends nudge its intensity), hold (plays the mood before it, held: the form's hold
//   section at its hold tempo), fallback (what plays at start and when nothing matches),
//   victory / lift (true unless written: victory cadences and climbing key changes play).
// rules: what plays when, top to bottom, the first match wins: (when: <cond>, mood, and
//   optionally intensity: "<expr>", else the mood's own song's intensity).
//   cond: InGame | InZone("Forest") | InBox([x, z], [x, z]) or InBox([x, y, z], [x, y, z])
//     around the camera | Near("<map spot>", radius) | Signal("<name>", Gt|Ge|Lt|Le|Eq|Ne,
//     value) | All([..]) | Any([..]) | Not(..). Signals are numbers the game's features
//     publish (unset ones read 0; `cargo test -p friendslop-side` lists them).
//   expr: numbers and signals with + - * / ( ) min(a, b) max(a, b) clamp(x, lo, hi).
// hush / silence: when the band fades out / cuts dead. victory_cues: the cues that play
//   a victory cadence.
// Each song file: mood (whose song it is), then bpm, swing, key (semitones above C), the
//   A/B/hook progressions, intensity, and the chances of an odd 7/8 bar / a modulation / a kime. Optional: steps (per bar, 16) and
//   beats (per bar, 4) for another meter (steps: 12 is a 12/8 shuffle), band (whose line-up
//   the shorthand below fills: "fusion"), form and feel (library names, the band's if not).
// Then either the shorthand, which the band turns into parts:
//   groove, bass (lines), comp, lead (Synth, Brass, Flute, Bell, Mini or Silent), arp (an
//   instrument; Kalimba plays the ostinato), pad (always, or only when calm), theme (plays
//   the signature hook), bass_inst, pad_inst, horns (None, Stabs, Swells, Both), kit (extra
//   shaker / conga / clap / ride), answer (who answers the lead), nylon (None, Bossa,
//   Pick([sections])), and optionally keys, hand (the conga part's drum) and perc (lanes).
// or the parts written out, each `(play: <generator>, ...)`:
//   play: Drums(groove: "City", ride: true, clap: true) | Bass(lines: ["SLAP1"]) |
//     Chords(comp: "City", under: "lead") | Arp | Ostinato(figure: "kalimba") |
//     Melody(style: "fusion", theme: "signature") | Answer() | Harmony(steps: -2) (the
//     melody doubled a diatonic third below; -5 a sixth below) | Horns(style: "fusion",
//     stabs: true, swells: true) | Pad(under: "lead", after_swell: true) |
//     Lane(lane: "shaker") | Kime(rhythms: "fusion", bass: Bass, keys: EPiano, horn: PolyBrass)
//     | Bells;
//   inst (who plays it), sections / not (where), when (conditions, see library.ron),
//   intensity: (lo, hi), bus and layer (its mix bus and level rules; default: always on),
//   register: (lo, hi).
//   They play in the order written; lanes play inside the kit's bar, the kime stands in for
//   the band on a section's last bar, and the answer echoes the melody.
//   e.g. parts: [(play: Drums(groove: "Laid")), (play: Bass(lines: ["LAID"]), inst: Upright),
//     (play: Chords(comp: "Laid"), inst: EPiano), (play: Melody(style: "fusion"), inst: Flute)]
(
    progressions: {
        // "Just the Two of Us": IVmaj9 - III7#9 - vim9 - vm9 I13.
        "JTTOU": [(5, Maj9, 4), (4, Dom7s9, 4), (9, Min9, 4), (7, Min9, 2), (0, Dom13, 2)],
        "CHROMATIC_TWO_FIVES": [(2, Min9, 2), (7, Dom13, 2), (1, Min9, 2), (6, Dom13, 2), (0, Maj9, 4), (9, Dom7alt, 4)],
        "EXPLORE_A": [(0, Maj9, 8), (5, Maj7s11, 8)],
        "EXPLORE_B": [(2, Min11, 4), (7, Sus9, 4), (0, Maj69, 4), (9, Dom7alt, 4)],
        "EXPLORE_HOOK": [(5, Maj9, 4), (4, Min9, 4), (2, Min9, 4), (1, Dom13s11, 4)],
        // "Kite Day": lydian lift between I and II, sunny and open.
        "KITE_A": [(0, Maj9, 4), (2, Dom13, 4), (0, Maj9, 4), (2, Dom13, 4)],
        "KITE_B": [(9, Min11, 4), (5, Maj7s11, 4), (2, Min9, 4), (7, Sus9, 4)],
        "KITE_HOOK": [(5, Maj9, 4), (7, Dom13, 4), (9, Min9, 4), (0, Maj69, 4)],
        // The city-pop "royal road": IV - V - iii - vi, then ii - bII (tritone sub).
        "ROYAL_ROAD": [(5, Maj9, 4), (7, Sus9, 2), (7, Dom13, 2), (4, Min9, 2), (9, Min9, 2), (2, Min9, 2), (1, Dom13s11, 2)],
        "VILLAGE_B": [(0, Maj9, 4), (10, Min9, 2), (3, Dom13, 2), (8, Maj7s11, 4), (7, Dom7alt, 4)],
        // Upbeat songs (more tunes for the wandering moods).
        // "Sunny Side": I - vi - ii - V, bright and bouncy.
        "SUNNY_A": [(0, Maj9, 4), (9, Min9, 4), (2, Min9, 4), (7, Dom13, 4)],
        // iii - VI7 - ii - V: the turnaround that keeps it moving.
        "SUNNY_B": [(4, Min9, 4), (9, Dom7s9, 4), (2, Min9, 4), (7, Sus9, 2), (7, Dom13, 2)],
        // "Night Market": vi - IV - V - I, driving.
        "MARKET_A": [(9, Min9, 4), (5, Maj9, 4), (7, Dom13, 4), (0, Maj69, 4)],
        "MARKET_B": [(2, Min9, 4), (7, Dom13s11, 4), (0, Maj9, 4), (9, Dom7alt, 4)],
        "MARKET_HOOK": [(5, Maj9, 4), (7, Dom13, 4), (4, Min9, 4), (9, Min9, 2), (1, Dom13s11, 2)],
        "FOREST_A": [(0, Maj7s11, 8), (9, Min11, 8)],
        // Descending lydian chords, ECM-style.
        "FOREST_B": [(5, Maj7s11, 4), (4, Min9, 4), (3, Maj7s11, 4), (2, Sus9, 4)],
        // I - iii - IV - iv (the borrowed minor iv).
        "MINOR_FOUR": [(0, Maj9, 4), (4, Min9, 4), (5, Maj7s11, 4), (5, Min6, 4)],
        "MAZE_A": [(0, Min11, 8), (8, Maj7s11, 8)],
        // Phrygian bII lydian, then a sus and an altered V.
        "MAZE_B": [(0, Min11, 4), (1, Maj7s11, 4), (10, Sus9, 4), (7, Dom7alt, 4)],
        "MAZE_HOOK": [(5, Min9, 4), (10, Dom13, 4), (3, Maj9, 4), (8, Maj7s11, 2), (7, Dom7alt, 2)],
        "SKY_B": [(9, Min11, 4), (2, Min9, 4), (7, Sus9, 4), (0, Maj69, 4)],
        "SKY_HOOK": [(5, Maj7s11, 4), (7, Sus9, 4), (4, Min9, 4), (9, Min11, 4)],
        // A bolero cycle in minor: i - ii-V - i - V/iv - iv - bVII - bIII - ii-V.
        "BOLERO_A": [(0, Min6, 4), (2, HalfDim, 2), (7, Dom7b9, 2), (0, Min6, 4), (0, Dom7b9, 4), (5, Min9, 4), (10, Dom13, 4), (3, Maj9, 4), (2, HalfDim, 2), (7, Dom7b9, 2)],
        "BOLERO_B": [(3, Maj9, 4), (8, Maj7s11, 4), (2, HalfDim, 4), (7, Dom7alt, 4)],
        "HIDE_A": [(0, MinMaj9, 4), (1, Maj7s11, 4), (0, MinMaj9, 4), (11, Dim7, 4)],
        "HIDE_B": [(8, Maj7s11, 4), (7, Dom7b9, 4), (0, Min11, 4), (1, Dom13s11, 4)],
        // Dorian vamp i9 - IV9.
        "SEEK_A": [(0, Min9, 8), (5, Dom9, 8)],
        "SEEK_B": [(8, Maj7s11, 4), (10, Sus9, 4), (0, Min11, 4), (7, Dom7s9, 4)],
        // bVI - bVII - i.
        "SEEK_HOOK": [(8, Maj7s11, 4), (10, Dom13, 4), (0, Min9, 8)],
        "SEWER_HOOK": [(0, Min11, 4), (10, Sus9, 4), (8, Maj7s11, 4), (7, Dom7alt, 4)],
        "DUEL_B": [(1, Maj7s11, 4), (0, Min11, 4), (1, Maj7s11, 4), (7, Dom7s9, 4)],
        "DUEL_HOOK": [(8, Maj9, 2), (10, Dom13, 2), (0, Min9, 4), (5, Min9, 2), (7, Dom7alt, 2), (0, Min11, 4)],
        "LANDLORD_A": [(0, MinMaj9, 4), (1, Dom13s11, 4), (0, MinMaj9, 4), (11, Dim7, 4)],
        // Chromatically climbing sus chords: the rent goes up.
        "LANDLORD_B": [(0, Sus9, 4), (1, Sus9, 4), (2, Sus9, 4), (7, Dom7alt, 4)],
        "LANDLORD_HOOK": [(8, Maj7s11, 4), (7, Dom7alt, 4), (0, MinMaj9, 4), (2, HalfDim, 2), (7, Dom7b9, 2)],
        // The sewers (#127): a dorian i - iv vamp, then borrowed lydian chords
        // dripping down to the minor V.
        "SEWER_A": [(0, Min9, 8), (5, Min11, 8)],
        "SEWER_B": [(8, Maj7s11, 4), (3, Maj9, 4), (1, Maj7s11, 4), (7, Dom7b9, 4)],
        // Wendy's (#117): a sunny diner jingle, I - vi - ii - V, with a slip
        // to the minor iv and a creepy diminished on the way to the hook.
        "WENDYS_A": [(0, Maj69, 4), (9, Min9, 4), (2, Min9, 4), (7, Dom13, 4)],
        "WENDYS_B": [(5, Maj9, 4), (5, Min6, 4), (0, Maj69, 2), (3, Dim7, 2), (2, Min9, 2), (7, Dom7b9, 2)],
        // The attic: the same jingle, gone minor and wrong (a minor-major
        // tonic, the tritone below, a half-diminished ii and a b9 dominant).
        "ATTIC_A": [(0, MinMaj9, 8), (8, Maj7s11, 4), (2, HalfDim, 2), (7, Dom7b9, 2)],
        "ATTIC_B": [(0, Min6, 4), (1, Maj7s11, 4), (6, Dim7, 4), (7, Dom7alt, 4)],
        "ATTIC_HOOK": [(5, Min6, 2), (6, Dim7, 2), (0, MinMaj9, 2), (9, Dim7, 2), (2, HalfDim, 2), (7, Dom7b9, 2), (0, MinMaj9, 4)],
        "WENDYS_HOOK": [(5, Maj9, 2), (6, Dim7, 2), (0, Maj69, 2), (9, Dom7s9, 2), (2, Min9, 2), (7, Dom13, 2), (0, Maj69, 4)],
        // New York, boom-bap: a minor-7th loop, i - iv, then bVI - bVII in the hook.
        "BOOM_A": [(0, Min7Aeo, 8), (5, Min7, 8)],
        "BOOM_B": [(3, Maj7, 8), (10, Dom7, 4), (0, Min7Aeo, 4)],
        "BOOM_HOOK": [(8, Maj7Lyd, 8), (10, Dom7, 8)],
        // New York, house: i - bVII - bVI - bVII, a bar each.
        "BUSTLE_A": [(0, Min7Aeo, 4), (10, MajMix, 4), (8, Maj7Lyd, 4), (10, MajMix, 4)],
        "BUSTLE_B": [(5, Min7, 8), (8, Maj7Lyd, 4), (10, MajMix, 4)],
        "BUSTLE_HOOK": [(8, Maj7Lyd, 4), (10, MajMix, 4), (0, Min7Aeo, 8)],
        // The bodega, cumbia: I - V7, then IV - I - V7 - I, triads.
        "CUMBIA_A": [(0, Maj, 8), (7, Dom7, 8)],
        "CUMBIA_B": [(5, MajLyd, 8), (0, Maj, 4), (7, Dom7, 4)],
        "CUMBIA_HOOK": [(0, Maj, 4), (5, MajLyd, 4), (7, Dom7, 4), (0, Maj, 4)],
        // The bodega, ranchera in 3/4 (beats of three): I - V7 - V7 - I, the
        // IV and the II7 (the secondary dominant) for the chorus.
        "VALS_A": [(0, Maj, 6), (7, Dom7, 6), (7, Dom7, 6), (0, Maj, 6)],
        "VALS_B": [(5, MajLyd, 6), (0, Maj, 6), (7, Dom7, 6), (0, Maj, 6)],
        "VALS_HOOK": [(0, Maj, 6), (2, Dom7, 6), (7, Dom7, 6), (0, Maj, 6)],
    },
    bass: {
        // Cumbia: root on one, fifth on three, a walk-up into the next chord.
        "CUMBIA": "R...5...R...5.A.",
        "CUMBIA2": "R..5R...R..5R.A.",
        "SLAP1": "R.GR.PGR..R.PGRA",
        "SLAP2": "R..GP..RR.GP.5-A",
        "PUMP": "R.R.P.R.R.R.P.RA",
        "LAID": "R-----.5..R---A.",
        "PEDAL": "R-------5-------",
        "SPARSE": "R-----....R-....",
        // Dub: a held root, space, and a late push back to it.
        "DUB": "R---..R-..5-.RA.",
        "BOLERO": "R-------5---3-A-",
        "TENSE": "R.R.R.R.R.R.R.R.",
        "DRIVE": "R.RP.RG.R.RP.RGA",
        "SHRED": "RGRPRGR5RGRPRG7A",
        "MARCH": "R...R...R...R.A.",
        // A walking line for the upright: root, third, fifth, approach.
        "WALK": "R...3...5...A...",
        "WALK2": "R...5...P...A...",
        // Boom-bap: a held root, a late pickup.
        "BOOM": "R-----....R-..5.",
        "BOOM2": "R-------..R-.A..",
        // House: the off-beat bass, and octaves.
        "HOUSE": "..R...R...R...R.",
        "OCTAVE": "R.P.R.P.R.P.R.PA",
        // Cumbia on one and three: root, then the fifth, a walk into the next chord.
        "CUMBIA13": "R-......5-......",
        "CUMBIA13B": "R-......5-..3.5.",
        // 3/4: the "oom" on one, root one bar, fifth the next (12 steps).
        "VALS": "R-..........",
        "VALS5": "5-..........",
    },
    moods: [
        (
            name: "Menu",
            tone: (warmth: 0.1, width: 1.15, wow: 0.25, lay_back_ms: 5.0, loose_ms: 3.0),
            level_db: 0.0,
            fallback: true, urgent: true, instant: true, victory: false, lift: false,
        ),
        (
            name: "Explore",
            tone: (warmth: -0.05, width: 1.2, wow: 0.2, lay_back_ms: 7.0, loose_ms: 4.0),
            level_db: 0.0,
            wandering: true,
        ),
        (
            name: "Village",
            tone: (warmth: -0.15, width: 1.15, wow: 0.1, lay_back_ms: 3.0, loose_ms: 2.5),
            level_db: 0.0,
            wandering: true,
        ),
        (
            name: "Forest",
            tone: (warmth: 0.3, width: 1.3, wow: 0.35, lay_back_ms: 8.0, loose_ms: 5.0),
            level_db: 0.5,
            wandering: true,
        ),
        (
            name: "Maze",
            tone: (warmth: 0.15, width: 0.95, wow: 0.2, lay_back_ms: 2.0, loose_ms: 2.0),
            level_db: 2.5,
            wandering: true,
        ),
        (
            name: "Sky",
            tone: (warmth: -0.2, width: 1.4, wow: 0.3, lay_back_ms: 5.0, loose_ms: 3.5),
            level_db: 2.0,
            wandering: true,
        ),
        (
            name: "Abuela",
            tone: (warmth: 0.5, width: 0.85, wow: 0.7, lay_back_ms: 10.0, loose_ms: 6.0),
            level_db: 0.5,
            wandering: true,
        ),
        (
            name: "Hiding",
            tone: (warmth: 0.4, width: 0.8, wow: 0.15, lay_back_ms: 1.0, loose_ms: 1.5),
            level_db: 3.5,
            instant: true,
        ),
        (
            name: "Seeking",
            tone: (warmth: -0.25, width: 1.05, wow: 0.0, lay_back_ms: 0.0, loose_ms: 1.0),
            level_db: 0.0,
            urgent: true, instant: true,
        ),
        (
            name: "Duel",
            tone: (warmth: 0.1, width: 1.1, wow: 0.3, lay_back_ms: 2.0, loose_ms: 2.5),
            level_db: 0.0,
            urgent: true, instant: true,
        ),
        (
            name: "Landlord",
            tone: (warmth: -0.2, width: 0.9, wow: 0.1, lay_back_ms: 0.0, loose_ms: 1.0),
            level_db: 0.0,
        ),
        (
            name: "Still",
            tone: (warmth: 0.35, width: 1.15, wow: 0.6, lay_back_ms: 0.0, loose_ms: 0.0),
            level_db: 3.5,
            hold: true, urgent: true, instant: true, victory: false, lift: false,
        ),
        (
            name: "Underground",
            tone: (warmth: 0.45, width: 1.3, wow: 0.45, lay_back_ms: 12.0, loose_ms: 5.0),
            level_db: 2.0,
            // Down in the tunnels everything rings off wet brick (#127).
            wet: 1.6, echo: 1.6,
            wandering: true,
        ),
        (
            name: "Wendys",
            tone: (warmth: 0.25, width: 1.1, wow: 0.35, lay_back_ms: 4.0, loose_ms: 3.0),
            level_db: 1.0,
            wandering: true,
        ),
        (
            name: "WendysAttic",
            tone: (warmth: 0.6, width: 1.4, wow: 0.95, lay_back_ms: 18.0, loose_ms: 8.0),
            level_db: 0.0,
            wandering: true,
        ),
        (
            name: "FartAlert",
            tone: (warmth: -0.3, width: 1.0, wow: 0.6, lay_back_ms: 0.0, loose_ms: 1.0),
            level_db: 1.5,
            urgent: true, instant: true,
        ),
        (
            name: "Nyc",
            tone: (warmth: 0.2, width: 1.15, wow: 0.25, lay_back_ms: 6.0, loose_ms: 3.0),
            level_db: 1.0,
            wandering: true,
        ),
        (
            name: "Bodega",
            tone: (warmth: 0.35, width: 1.0, wow: 0.45, lay_back_ms: 6.0, loose_ms: 4.0),
            level_db: 1.0,
            wandering: true,
        ),
    ],
    // What plays when: the first rule that matches.
    rules: [
        (when: Not(InGame), mood: "Menu"),
        // The stillness (everything freezes).
        (when: Signal("frozen", Gt, 0.0), mood: "Still", intensity: "0.2"),
        // You farted in front of someone.
        (when: Signal("shamed", Gt, 0.0), mood: "FartAlert"),
        // Duelling: flat out on your last life.
        (when: All([Signal("duel", Gt, 0.0), Signal("duel_lives", Le, 1.0)]), mood: "Duel", intensity: "1.0"),
        (when: Signal("duel", Gt, 0.0), mood: "Duel", intensity: "0.9"),
        // Hide and seek: tenser as the clock runs down.
        (when: Signal("hiding", Gt, 0.0), mood: "Hiding", intensity: "0.3 + 0.2 * clamp(1 - secs_left / 30, 0, 1)"),
        (when: Signal("seeking", Gt, 0.0), mood: "Seeking", intensity: "0.65 + 0.35 * (1 - clamp(secs_left / seek_secs, 0, 1))"),
        // The landlord: the boss fight, then his rent rising as you near him.
        (when: Signal("landlord_boss", Gt, 0.0), mood: "Landlord", intensity: "0.75 + 0.2 * clamp(1 - boss_hp / 12, 0, 1)"),
        (when: All([Signal("near_landlord", Gt, 0.0), Not(Signal("won", Gt, 0.0))]), mood: "Landlord", intensity: "min(0.4 + 0.08 * raises, 0.8)"),
        // Places.
        (when: Signal("underground", Gt, 0.0), mood: "Underground"),
        (when: Signal("wendys_attic", Gt, 0.0), mood: "WendysAttic"),
        (when: Signal("wendys", Gt, 0.0), mood: "Wendys"),
        (when: Signal("nyc_shop_bodega", Gt, 0.0), mood: "Bodega"),
        (when: Signal("nyc", Gt, 0.0), mood: "Nyc"),
        (when: Signal("heaven", Gt, 0.0), mood: "Abuela"),
        (when: Signal("sky", Gt, 0.0), mood: "Sky"),
        (when: Any([InZone("Commune"), InZone("Village")]), mood: "Village"),
        (when: Any([InZone("Forest"), InZone("Valley")]), mood: "Forest"),
        (when: InZone("Ruins"), mood: "Maze"),
        (when: All([]), mood: "Explore"),
    ],
    // The band fades out under an attack's strings, in the dark of the warehouse and down
    // in Fulton St station; the endless hallway cuts it dead.
    hush: Any([Signal("attack", Gt, 0.0), Signal("spooked", Gt, 0.0), Signal("fulton", Gt, 0.0)]),
    silence: Signal("adrift", Gt, 0.0),
    // A round won, a duel survived, a chapter done, the landlord beaten.
    victory_cues: ["victory"],
)
