// Fulton St station (crates/side/src/features/fulton.rs).
// Edit and save: the running game picks it up within a second (the station's
// layout is built when you enter the game, so a new layout needs a new game).
(
    // The subway entrance on the city's sidewalk (x, z), and which way its
    // open end faces (degrees about +y; 90 opens towards +x, the avenue).
    entrance: (-14.0, 228.0),
    entrance_yaw: 90.0,
    // The hole in the street its stairs go down through, in the entrance's
    // own frame: its middle along the entrance (+ towards the open end),
    // size across and along (m), and its lining: depth below the street and
    // how far above the street it starts (the sidewalk's kerb).
    entrance_hole: (offset: -0.08, size: (2.6, 6.25), depth: 3.7, lip: 0.15),
    // Walk this far (metres) down the stairs and you're in the station.
    entrance_reach: 1.8,
    // The middle of the station's grid under the city (x, z). Its levels
    // stack downwards from 12 m under the street, 4 m apart.
    station_at: (40.0, 280.0),
    // How many levels deep it goes. The J is on the last one.
    levels: 40,
    // Cells across (x) and deep (z) on every level; a cell is 6 m.
    width: 6,
    depth: 6,
    // The signed way across one level is at least this many cells long.
    min_path: 7,
    // Same seed, same station (on every peer).
    seed: 1170,
    // Subway platforms with empty tracks: every this many levels (from the
    // top, never the J's) a level gets at least this many cells of platform
    // and track bed (the track pieces in fulton_tiles.ron), and at most
    // platform_max (the level below winds round solid ground under them).
    // 0 turns them off.
    platform_every: 3,
    platform_cells: 3,
    platform_max: 6,
    // Lights: one under every cell's fluorescent fittings (lumens, reach in
    // m, height above the floor), and a dim one that goes with you so dark
    // corners aren't pitch black.
    light: (
        cell_lumens: 45000.0,
        cell_range: 9.0,
        cell_height: 3.4,
        follow_lumens: 15000.0,
        follow_range: 8.0,
        // The nearest this many cell lights cast shadows (0 for none).
        shadow_lights: 4,
        // Down here the sky is out: the ambient light (outside it's 1100), and
        // a dim haze from fog_start to fog_end metres.
        ambient: 25.0,
        fog_start: 12.0,
        fog_end: 45.0,
    ),
    // Big rooms (concourses, fare halls) a few cells across among the
    // corridors, so a level isn't all hallways: the chance a level has any,
    // at most how many, their sizes in cells (also tried turned round), and
    // how many doors each has (at least, at most). The corridors are run up
    // to their doors; chance 0 turns them off.
    rooms: (chance: 0.7, max: 2, sizes: [(2, 2), (3, 2), (3, 3)], doors: (2, 3)),
    // The reward for reaching the J: this much Pelf (the stats' wealth, max 10).
    reward_pelf: 3,
    // Toasts.
    enter_line: "Fulton St. Follow the J signs to Brooklyn.",
    level_line: "Fulton St, level {n} of {of}. The J is still further down.",
    reward_line: "The J to Brooklyn. You actually found it. Pelf +{pelf}.",
    again_line: "The J to Brooklyn. Still here. Still waiting.",
    // The way-out posts' labels.
    exit_label: "climb back up to the street",
    ride_label: "ride the J (back up to the street)",
    // Down here every sound echoes off the tiles: this many times the open
    // air's reverb send, ringing this many seconds. No music down here.
    echo_wet: 6.0,
    echo_secs: 2.8,
    // Andrew's calls and the thing he sends (fulton_hunt.rs; his lines are in
    // data/text/fulton_calls.ron).
    hunt: (
        // He calls when you first reach these levels (0 is the top).
        call_levels: [6, 14, 22],
        // Ringing this long answers it anyway.
        ring_secs: 10.0,
        // Seconds between lines.
        line_gap: 0.7,
        // His voice per call: (pitch Hz, speed). Angrier, higher, faster.
        voice: [(92.0, 1.0), (118.0, 1.15), (150.0, 1.35)],
        // After the third call, the one he sent arrives this many seconds later.
        spawn_delay: 12.0,
        // Its speeds (m/s): wandering and searching, and chasing. You walk 5 and run 10.5.
        walk_speed: 3.0,
        chase_speed: 6.5,
        // It sees this far (m) in a cone this wide (degrees), never through walls.
        view_range: 20.0,
        view_degrees: 110.0,
        // It grabs you this close (m).
        catch_range: 1.4,
        // The director: every 9 s it hears roughly where you are and heads for a
        // cell within 3 cells of you.
        director_secs: 9.0,
        director_radius: 3,
        // Out of sight, it keeps heading where it last saw you for this long.
        lose_secs: 5.0,
        // Then it checks the lockers within 4 cells for 20 s, opening the one
        // you're in with this chance...
        search_radius: 4,
        search_secs: 20.0,
        find_chance: 0.35,
        // ...then backs off at least 6 cells for 25 s before drifting back.
        retreat_cells: 6,
        retreat_secs: 25.0,
    ),
)
