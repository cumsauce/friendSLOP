// Tuning for drowning (crates/afterlife/src/features/drowning.rs).
// Edit and save: the running game picks it up within a second.
(
    // Feet this far (metres) below the water's surface count as out of your depth.
    depth: 1.2,
    // How long you can stay out of your depth before you drown (seconds).
    secs: 12.0,
)
