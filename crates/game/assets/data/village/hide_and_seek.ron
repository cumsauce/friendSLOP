// Tuning for hide and seek (crates/village/src/features/hide_and_seek.rs).
// Edit and save: the running game picks it up within a second.
(
    hide_secs: 30.0,
    seek_secs: 180.0,
    results_secs: 10.0,
    // Hiders hear a heartbeat when a seeker is this close (metres).
    heartbeat_range: 6.0,
)
