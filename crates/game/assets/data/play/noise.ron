// How loud you are (`noise.rs`): how far (m) each way of moving carries.
// Something hears you when it stands within this of your feet.
// There's no crouch input yet; the radius waits for one.
(
    // Almost nothing crouched.
    crouch: 1.5,
    // Very small walking.
    walk: 5.0,
    // Large running.
    run: 12.0,
    // Large jumping (and falling).
    air: 10.0,
)
