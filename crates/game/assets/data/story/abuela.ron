// Tuning for abuela (crates/story/src/features/abuela.rs).
// Edit and save: the running game picks it up within a second.
(
    // How close (on the island) counts as visiting her.
    greet_radius: 4.0,
    // She doesn't talk over herself.
    quiet_secs: 3.0,
    // How long her words stay on screen.
    shown_secs: 6.0,
    // Seconds per syllable: she speaks slowly.
    syl: 0.19,
)
