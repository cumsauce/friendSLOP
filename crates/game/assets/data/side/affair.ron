// Tuning for affair (crates/side/src/features/affair.rs).
// Edit and save: the running game picks it up within a second.
(
    // The wife catches a flirt within this distance of you.
    wife_sight: 10.0,
    // During an affair she smells the perfume this close.
    perfume_range: 2.5,
    // Flirts until it's an affair.
    flirts_for_affair: 3,
    // The wife's walking speed, m/s.
    wife_speed: 1.1,
)
