    giants: [
        (model: 1, at: (4320.0, -1800.0), scale: 17.0, yaw: 20.0),
        (model: 2, at: (3420.0, -2010.0), scale: 12.0, yaw: 70.0),
        (model: 3, at: (3560.0, -1850.0), scale: 11.0, yaw: 130.0),
