// Fulton St station (crates/side/src/features/fulton.rs).
// Edit and save: the running game picks it up within a second (the station's
// layout is built when you enter the game, so a new layout needs a new game).
(
    // The subway entrance on the city's sidewalk (x, z), and which way its
    // open end faces (degrees about +y; 90 opens towards +x, the avenue).
    entrance: (-14.0, 167.0),
    entrance_yaw: 90.0,
    // The hole in the street its stairs go down through, in the entrance's
    // own frame: its middle along the entrance (+ towards the open end),
    // size across and along (m), and its lining: depth below the street and
    // how far above the street it starts (the sidewalk's kerb).
    entrance_hole: (offset: -0.08, size: (2.6, 6.25), depth: 3.7, lip: 0.15),
    // Walk this far (metres) down the stairs and you're in the station.
    entrance_reach: 1.8,
    // The middle of the station's grid under the city (x, z). Its levels
    // stack downwards from 12 m under the street, 4 m apart.
    station_at: (40.0, 280.0),
    // How many levels deep it goes. The J is on the last one.
    levels: 40,
    // Levels are planned and built as you go down, this many below the
    // deepest player (the top this many when New York loads): at least 2,
    // so the level under you is solid before you drop into it.
    plan_ahead: 2,
    // Cells across (x) and deep (z) on every level; a cell is 6 m.
    width: 6,
    depth: 6,
    // The signed way across one level is at least this many cells long.
    min_path: 7,
    // Same seed, same station (on every peer).
    seed: 1170,
    // Subway platforms with empty tracks: every this many levels (from the
    // top, never the J's) a level gets at least this many cells of platform
    // and track bed (the track pieces in fulton_tiles.ron), and at most
    // platform_max (the level below winds round solid ground under them).
    // 0 turns them off.
    platform_every: 3,
    platform_cells: 3,
    platform_max: 6,
    // Lights: one under every cell's fluorescent fittings (lumens, reach in
    // m, height above the floor), and a dim one that goes with you so dark
    // corners aren't pitch black. Kept low on purpose: the camera's eye
    // adaptation (graphics.ron) brightens a scene only a little darker than
    // daylight back up, so a dim subway has to be well under it.
    light: (
        cell_lumens: 6000.0,
        cell_range: 9.0,
        cell_height: 3.4,
        follow_lumens: 500.0,
        follow_range: 6.0,
        // Reflections: the station's baked probe ("fulton", baked in a hall;
        // FRIENDSLOP_BAKE=1), this bright.
        probe: 0.4,
        // The nearest this many cell lights cast shadows (0 for none).
        shadow_lights: 2,
        // The share of cells whose ceiling light still works; the rest are broken.
        working: 0.2,
        // From this level down (0 is the top) a level may be pitch dark: no
        // working lights, no glow around you, only your flashlight. This is
        // the chance each one is.
        dark_from: 7,
        dark_chance: 0.35,
        // Your flashlight down here (as in the warehouse): lumens, reach (m),
        // and its cone's outer and inner half-angles (degrees).
        flashlight_lumens: 400000.0,
        flashlight_range: 22.0,
        flashlight_outer: 24.0,
        flashlight_inner: 13.0,
        // A broken light's skin: its tubes stop glowing and their colour is
        // scaled by this (dead, dusty glass).
        broken_tint: 0.35,
        // The top levels, from the top, before it all goes bad (below these the
        // settings above): the share of lights that work, the look
        // (data/base/place_looks.ron: Kept "fulton_kept", Worn "fulton_worn",
        // Bad the station's usual), how much of the usual rubble (0..1), and
        // whether the creepy music plays (else the city's goes on).
        // Floors 1 and 2 are a working station, 3 is run down; on 4 the
        // hunter arrives (hunt.call_levels) and it's like this from there.
        stages: [
            (working: 0.95, look: Kept, rubble: 0.0, creepy: false),
            (working: 0.9, look: Kept, rubble: 0.0, creepy: false),
            (working: 0.5, look: Worn, rubble: 0.4, creepy: true),
        ],
        // How dark it is down here (no sky, a dim haze): data/base/place_looks.ron
        // ("fulton", and "fulton_dark" on the pitch-dark levels).
    ),
    // Big rooms (concourses, fare halls) a few cells across among the
    // corridors, so a level isn't all hallways: the chance a level has any,
    // at most how many, their sizes in cells (also tried turned round), and
    // how many doors each has (at least, at most). The corridors are run up
    // to their doors; chance 0 turns them off. More doors make loops.
    rooms: (
        chance: 0.8,
        max: 2,
        sizes: [(2, 2), (3, 2), (3, 3), (2, 3), (1, 4), (2, 4)],
        doors: (2, 4),
        // What each room is for, picked by weight among the kinds that come
        // in its size (either way round; none listed: any size). `columns`
        // stands a column where four of its cells meet. Props (models under
        // assets/models/): `Wall` ones stand against a walled side (never a
        // door) at each `slots` spot along it (m from the wall's middle) with
        // `chance`, facing in (`flush`: modelled with its back on the wall
        // at z = 0, so it goes right on the wall's face); `Middle` ones lie
        // somewhere within `slots[0]` m of a cell's middle (never solid);
        // `Ceiling` ones hang there from the ceiling, `lift` m of them above
        // their origin. `lift` raises a model onto the floor, `size` is a
        // wall prop's collider (along, up, out; zeros for none), `scale` its
        // size, `yaw` turns it (degrees).
        // L-shaped rooms: the chance a room 2x2 or bigger loses a corner
        // block (half its size each way, rounded down) back to corridor.
        l_chance: 0.35,
        // Tall rooms with mezzanines: the chance a room is tall, and how far
        // (m, at most 1.9) its floor sinks into the level below (whose cells
        // there turn solid). The cells with doors stay up as railed decks;
        // stairs go down from them until the whole room joins up.
        tall: (chance: 0.45, sink: 1.6),
        kinds: [
            (name: "concourse", weight: 2.0, sizes: [(3, 3), (3, 2), (2, 4)], columns: true, props: [
                (model: "features/fs_bench.gltf", chance: 0.35, slots: [-1.2, 1.2], size: (2.0, 0.95, 0.5)),
                (model: "features/fs_trash_can.gltf", chance: 0.2, slots: [2.3], size: (0.65, 0.95, 0.65)),
                (model: "features/fs_poster_frame.gltf", flush: true, chance: 0.3, slots: [0.0]),
                (model: "features/fs_platform_clock.gltf", place: Ceiling, chance: 0.15, slots: [1.0]),
                (model: "features/fs_trash_litter.gltf", place: Middle, chance: 0.3, slots: [1.5]),
            ]),
            (name: "waiting room", weight: 1.5, sizes: [(2, 2), (2, 3), (3, 2)], props: [
                (model: "features/fs_bench.gltf", chance: 0.6, slots: [-1.3, 1.3], size: (2.0, 0.95, 0.5)),
                (model: "features/fs_vending_machine.gltf", chance: 0.2, slots: [2.2], size: (1.0, 1.9, 0.6)),
                (model: "features/fs_payphone.gltf", flush: true, chance: 0.2, slots: [-2.3], size: (0.7, 1.9, 0.4)),
                (model: "features/fs_trash_can.gltf", chance: 0.15, slots: [0.0], size: (0.65, 0.95, 0.65)),
                (model: "features/fs_platform_clock.gltf", place: Ceiling, chance: 0.25, slots: [0.5]),
            ]),
            (name: "token booth", weight: 1.0, sizes: [(2, 2), (3, 2), (2, 3)], columns: true, props: [
                (model: "props/counter.gltf", chance: 0.35, slots: [0.0], lift: 0.41, size: (1.9, 1.2, 0.65), scale: 1.2),
                (model: "features/fs_turnstile.gltf", chance: 0.45, slots: [-1.8, 1.8], size: (0.75, 1.25, 1.2)),
                (model: "features/fs_fare_gate.gltf", chance: 0.2, slots: [0.0], yaw: 90.0, size: (1.35, 1.2, 0.15)),
                (model: "features/fs_call_box.gltf", flush: true, chance: 0.25, slots: [2.4]),
            ]),
            (name: "storage", weight: 1.5, sizes: [(2, 2), (2, 3), (1, 4)], props: [
                (model: "props/crates_single.gltf", chance: 0.55, slots: [-1.7, 0.0, 1.7], lift: 0.41, size: (1.0, 0.82, 1.0)),
                (model: "features/fs_trash_pile.gltf", chance: 0.25, slots: [-1.0, 1.0], size: (1.2, 0.67, 1.05), scale: 0.7),
                (model: "features/fs_shopping_cart.gltf", place: Middle, chance: 0.2, slots: [1.2]),
                (model: "features/fs_trash_bag.gltf", place: Middle, chance: 0.3, slots: [1.5]),
            ]),
            (name: "boiler room", weight: 1.0, sizes: [(2, 2), (1, 4), (2, 3)], props: [
                (model: "features/fs_pump.gltf", chance: 0.35, slots: [-1.5, 1.5], size: (1.5, 1.15, 0.75)),
                (model: "features/fs_valve_cluster.gltf", flush: true, chance: 0.25, slots: [0.0], lift: 0.4, size: (1.4, 1.6, 0.4)),
                (model: "features/fs_breaker_box.gltf", flush: true, chance: 0.3, slots: [2.2]),
                (model: "features/fs_pipe_run.gltf", flush: true, chance: 0.9, slots: [-2.0, 0.0, 2.0], lift: 3.0),
                (model: "features/fs_duct_straight.gltf", place: Ceiling, chance: 0.4, slots: [0.5], lift: 0.8),
                (model: "features/fs_floor_drain.gltf", place: Middle, chance: 0.6, slots: [0.5]),
            ]),
            (name: "flooded hall", weight: 1.0, props: [
                (model: "features/fs_puddle.gltf", place: Middle, chance: 0.9, slots: [0.8], scale: 1.8),
                (model: "features/fs_ceiling_panel.gltf", place: Middle, chance: 0.4, slots: [1.8]),
                (model: "features/fs_broken_light.gltf", place: Ceiling, chance: 0.35, slots: [1.0]),
                (model: "features/fs_pump.gltf", chance: 0.15, slots: [1.0], size: (1.5, 1.15, 0.75)),
            ]),
            (name: "long gallery", weight: 4.0, sizes: [(1, 4)], props: [
                (model: "features/fs_bench.gltf", chance: 0.35, slots: [0.0], size: (2.0, 0.95, 0.5)),
                (model: "features/fs_poster_frame.gltf", flush: true, chance: 0.45, slots: [-1.8, 1.8]),
                (model: "features/fs_wall_grille.gltf", flush: true, chance: 0.15, slots: [0.0], lift: 1.6),
                (model: "features/fs_trash_litter.gltf", place: Middle, chance: 0.3, slots: [1.5]),
            ]),
            // Where someone's been living down here.
            (name: "encampment", weight: 1.0, sizes: [(2, 2), (2, 3), (3, 2)], props: [
                (model: "features/fs_camp.gltf", flush: true, chance: 0.5, slots: [-1.2, 1.2], size: (1.6, 0.9, 1.27), scale: 0.7),
                (model: "features/fs_shopping_cart.gltf", place: Middle, chance: 0.5, slots: [1.5]),
                (model: "features/fs_trash_pile.gltf", chance: 0.3, slots: [2.0], size: (1.2, 0.67, 1.05), scale: 0.7),
                (model: "features/fs_trash_litter.gltf", place: Middle, chance: 0.5, slots: [1.8]),
            ]),
            // Closed for works and never opened again.
            (name: "works", weight: 1.0, sizes: [(2, 2), (1, 4), (2, 3), (3, 2)], props: [
                (model: "features/fs_barricade.gltf", chance: 0.4, slots: [-1.2, 1.2], size: (1.8, 1.0, 0.65)),
                (model: "features/fs_cone.gltf", chance: 0.4, slots: [-2.4, 0.0, 2.4], size: (0.4, 0.7, 0.4)),
                (model: "features/fs_caution_tape.gltf", chance: 0.3, slots: [0.0]),
                (model: "features/fs_cable_tray.gltf", flush: true, chance: 0.6, slots: [-2.0, 0.0, 2.0], lift: 3.0),
                (model: "features/fs_broken_light.gltf", place: Ceiling, chance: 0.4, slots: [1.0]),
            ]),
        ],
        // The plain corridor pieces' props, placed the same way (sparse: most
        // of a level is corridor).
        corridors: [
            (model: "features/fs_trash_litter.gltf", place: Middle, chance: 0.12, slots: [1.8]),
            (model: "features/fs_trash_bag.gltf", place: Middle, chance: 0.06, slots: [2.0]),
            (model: "features/fs_puddle.gltf", place: Middle, chance: 0.06, slots: [1.2]),
            (model: "features/fs_floor_drain.gltf", place: Middle, chance: 0.05, slots: [1.5]),
            (model: "features/fs_ceiling_panel.gltf", place: Middle, chance: 0.03, slots: [1.5]),
            (model: "features/fs_broken_light.gltf", place: Ceiling, chance: 0.04, slots: [0.5]),
            (model: "features/fs_duct_straight.gltf", place: Ceiling, chance: 0.04, slots: [0.0], lift: 0.8),
            (model: "features/fs_poster_frame.gltf", flush: true, chance: 0.06, slots: [-1.5, 1.5]),
            (model: "features/fs_wall_grille.gltf", flush: true, chance: 0.04, slots: [-1.2], lift: 1.6),
            (model: "features/fs_call_box.gltf", flush: true, chance: 0.02, slots: [0.0]),
            (model: "features/fs_payphone.gltf", flush: true, chance: 0.02, slots: [1.8], size: (0.7, 1.9, 0.4)),
            (model: "features/fs_cable_tray.gltf", flush: true, chance: 0.05, slots: [-2.0, 0.0, 2.0], lift: 3.0),
            (model: "features/fs_trash_can.gltf", chance: 0.03, slots: [-2.2], size: (0.65, 0.95, 0.65)),
            (model: "features/fs_vending_machine.gltf", chance: 0.015, slots: [0.0], size: (1.0, 1.9, 0.6)),
            (model: "features/fs_cone.gltf", chance: 0.02, slots: [2.2], size: (0.4, 0.7, 0.4)),
        ],
    ),
    // Caved-in corridors, rolled for every open side between two corridor
    // cells: the chance it's blocked by rubble (only where there's another
    // way round; where there isn't it becomes a squeeze instead), the chance
    // it's a squeeze (rubble heaps either side), and a squeeze's gap (m).
    collapse: (blocked: 0.07, squeeze: 0.02, gap: 1.4),
    // Train tunnels: every this many levels (from `offset`, 0 is the top) the
    // stairs drop you into a ring of big double-track tunnel tiles (12 m, curves
    // and straights; fulton_tiles.ron) round the edge of the level instead of
    // corridors. The stairs down are across the ring, so there are two arms of
    // at least three tiles. A straight tile caves in across its middle with
    // chance `blocked` (rubble you can't pass; where that would cut something
    // off it's a squeeze instead) or is a squeeze with chance `squeeze`. Leave
    // out a level that's a platform level or the one below one (their track
    // beds sink into it). `every: 0` turns them off.
    tunnels: (every: 4, offset: 2, blocked: 0.3, squeeze: 0.12),
    // Cars left standing on the platforms' tracks (10 ft B Division cars,
    // their floors level with the platform): the chance of one on each
    // straight run of three platform cells, and which, by weight. `open`
    // ones have their platform-side doors open and you can walk through.
    trains: (
        chance: 0.6,
        cars: [
            (model: "features/fs_train_stopped.gltf", weight: 2.0),
            (model: "features/fs_train_dead.gltf", weight: 1.5),
            (model: "features/fs_train_open.gltf", weight: 1.5, open: true),
        ],
    ),
    // The reward for reaching the J: this much Pelf (the stats' wealth, max 10).
    reward_pelf: 3,
    // Toasts.
    enter_line: "Fulton St. Follow the J signs to Brooklyn.",
    level_line: "Fulton St, level {n} of {of}. The J is still further down.",
    reward_line: "The J to Brooklyn. You actually found it. Pelf +{pelf}.",
    again_line: "The J to Brooklyn. Still here. Still waiting.",
    // The way-out posts' labels.
    exit_label: "climb back up to the street",
    ride_label: "ride the J (back up to the street)",
    // Down here every sound echoes off the tiles: this many times the open
    // air's reverb send, ringing this many seconds. (The music down here is the hunter's score.)
    echo_wet: 6.0,
    echo_secs: 2.8,
    // Andrew's calls and the thing he sends (fulton_hunt.rs; his lines are in
    // data/text/fulton_calls.ron).
    hunt: (
        // He calls when you first reach these levels (0 is the top).
        call_levels: [1, 2, 3],
        // Ringing this long answers it anyway.
        ring_secs: 10.0,
        // Seconds between lines.
        line_gap: 0.7,
        // His voice per call: pitch (Hz), speed, and the mood from data/base/speech.ron.
        // Angrier, higher, faster. He's on the phone, so `effect: Phone` (a band-limited,
        // clipped line). A line can say it another way with a trailing [mood].
        voice: [
            (pitch: 92.0, speed: 1.0, mood: "annoyed", effect: Phone, seed: 3),
            (pitch: 118.0, speed: 1.15, mood: "angry", effect: Phone, seed: 3),
            (pitch: 150.0, speed: 1.35, mood: "furious", effect: Phone, seed: 3),
        ],
        // After the third call, the one he sent arrives this many seconds later.
        spawn_delay: 4.0,
        // Its speeds (m/s): wandering and searching, and chasing. You walk 5 and run 10.5.
        walk_speed: 3.0,
        chase_speed: 6.5,
        // It sees this far (m) in a cone this wide (degrees), never through walls.
        view_range: 25.0,
        view_degrees: 160.0,
        // It grabs you this close (m).
        catch_range: 1.4,
        // The director: every 9 s it hears roughly where you are and heads for a
        // cell within 3 cells of you.
        director_secs: 9.0,
        director_radius: 3,
        // Hold it in clear sight this long and it stops pretending: it curls into
        // a ball and rolls at you, faster than you run (you run 10.5).
        roll_sight_secs: 3.0,
        // How fast the ball rolls (m/s).
        roll_speed: 12.0,
        // A roll lasts this long, then it breaks back into a run.
        roll_secs: 3.2,
        // Then it can't roll again for this long.
        roll_cooldown_secs: 9.0,
        // How fast it turns to face where it's going (degrees a second).
        turn_speed: 150.0,
        // At chase speed it turns this slowly (degrees a second), so a runner
        // swings wide round corners (between walk and chase speed it blends).
        run_turn_speed: 70.0,
        // Metres between footfalls: half a stride of each clip (ground speed
        // from gaits.ron x half the cycle: walk 2.89 x 0.4 s, run 6.64 x 0.3 s).
        walk_step_m: 1.16,
        run_step_m: 1.99,
        // A turn wider than this many degrees slows a runner down...
        slow_turn_degrees: 50.0,
        // ...to this fraction of its speed for a full about-turn.
        turn_slow_min: 0.35,
        // Speeding up and slowing down (m/s per second).
        accel: 14.0,
        decel: 22.0,
        // It eases to a stop over this many seconds of travel as it reaches the
        // spot the server has it at.
        follow_secs: 0.15,
        // Behind the server by more than this many metres, it hurries by
        // this many extra m/s per metre further back, so tight turns don't
        // leave it trailing.
        catch_up_slack: 1.5,
        catch_up_gain: 2.0,
        // ...but never faster than this many times its walk or run speed.
        max_hurry: 1.3,
        // Out of sight, it keeps heading where it last saw you for this long.
        lose_secs: 5.0,
        // Then it checks the lockers within 4 cells for 20 s, opening the one
        // you're in with this chance...
        search_radius: 4,
        search_secs: 20.0,
        find_chance: 0.35,
        // ...then backs off at least 6 cells for 25 s before drifting back.
        retreat_cells: 6,
        retreat_secs: 25.0,
        // Then the director stays off you for 30 s more: it wanders somewhere at
        // least 6 cells from you (looking up to 10 cells out). While you're in a
        // locker it never homes in on you either: it has nothing to go on.
        calm_secs: 30.0,
        calm_cells: 6,
        wander_cells: 10,
        // The music (data/music/moods.ron: FultonChase, FultonTense, FultonAmbient).
        // A hunter chasing or rolling within this many metres of you is "after you": the
        // stinger plays as it starts and the chase music runs while it lasts (the server
        // keeps who it's after to itself, so this is how near it is)...
        music_chase_range: 45.0,
        // ...and when it stops (it lost you, or you got out of its range) the music stays
        // tense this many seconds while it searches, then falls back to the ambience.
        music_tense_secs: 25.0,
    ),
)
