// Tuning for halt (crates/story/src/features/halt.rs).
// Edit and save: the running game picks it up within a second.
(
    // Escape gained per pry.
    pry_escape: 2,
    // Seconds for wrath to fill on its own.
    wrath_fill_secs: 120.0,
    // Seconds each monologue line is shown.
    rant_line_secs: 4.0,
)
