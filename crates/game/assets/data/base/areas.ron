// Areas (docs/design/performance-and-areas.md, crates/base/src/areas.rs):
// every part of the world that loads and unloads as a whole. Everything
// spawned into the world belongs to one area (or is a global, `areas::GLOBALS`).
// Every site in sites.ron names its area. Nothing is despawned yet that
// hasn't moved under an area. Edit and save: the game picks it up.
(
    // Each area: its id (what code and sites.ron call it), its name, its box
    // on the ground ((min x, min z), (max x, max z), m; as tall as the world),
    // its modeler map (`Some("maps/<area>.bsn")` or `None`), how far (m)
    // outside the box it starts loading, and how much further (m) everyone
    // must be before it unloads (so walking along the edge doesn't flicker).
    // A place stacked over or under another adds `heights: Some((min y, max y))`
    // (left out, an area is as tall as the world); where two hold you, the
    // stacked one is where you are. You reach the stacked places below by
    // teleport (a door, a ladder, dying), so they load only close up.
    areas: [
        // The whole commune map, edge-of-world hills included (one area
        // for now; districts later, maybe).
        (id: "commune", name: "The commune", bounds: ((-110.0, -110.0), (110.0, 110.0)), map: Some("maps/commune.bsn"), load: 40.0, unload: 20.0),
        // New York's city floor, with Penn Station, Fulton St and Miami
        // stacked over and under it.
        // The warehouse's inside (#130): a map of its own deep under the
        // meadow, built from the expedition's seed. Its outside is the commune's.
        (id: "warehouse", name: "Inside the warehouse", bounds: ((-20.0, -20.0), (20.0, 20.0)), map: None, load: 4.0, unload: 4.0, heights: Some((-64.0, -46.0))),
        // The tunnels under the whole map (#127), between the meadow and the warehouse.
        (id: "underground", name: "The tunnels", bounds: ((-110.0, -110.0), (110.0, 110.0)), map: None, load: 4.0, unload: 4.0, heights: Some((-38.0, -18.0))),
        // The hell pit far under the forest (the `hell` spot): the dead cross it.
        (id: "afterlife", name: "Hell", bounds: ((-80.0, -80.0), (-40.0, -40.0)), map: None, load: 4.0, unload: 4.0, heights: Some((-160.0, -118.0))),
        // The infinite hallways and stairs, stacked far over the map.
        (id: "infinite", name: "The sky courses", bounds: ((-120.0, -120.0), (120.0, 120.0)), map: None, load: 4.0, unload: 4.0, heights: Some((330.0, 5000.0))),
        // The surf course (#306), far out east in the sky; in through the
        // brownstone's door in New York (its sign is New York's). One area for the
        // whole course, every themed pack's map included (maps/surf.bsn and
        // maps/surf_<pack>.bsn, crates/side/src/features/surf_map.rs): it all loads
        // behind the curtain as you come in, so nothing pops in mid-run.
        (id: "surf", name: "The surf course", bounds: ((3840.0, -2500.0), (9700.0, 145.0)), map: Some("maps/surf.bsn"), load: 4.0, unload: 4.0, look: Some("surf")),
        // The Ceiling Fan Museum (its own map, maps/fan_museum.bsn, laid out around the
        // `fan_museum` spot at (62, -56)): the museum, its west annex and the parking lot.
        (id: "fan_museum", name: "The Ceiling Fan Museum", bounds: ((10.0, -84.0), (84.0, -40.0)), map: Some("maps/fan_museum.bsn"), load: 4.0, unload: 4.0, heights: Some((-100.0, -78.0))),
        (id: "nyc", name: "New York City", bounds: ((-90.0, 116.0), (90.0, 330.0)), map: Some("maps/nyc.bsn"), load: 40.0, unload: 20.0),
    ],
)
