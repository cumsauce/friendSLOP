// Tuning for punishment (crates/village/src/features/punishment.rs).
// Edit and save: the running game picks it up within a second.
(
    // How long attack mode lasts.
    attack_secs: 60.0,
    // How fast villagers chase (walking is 5 m/s, so you can just stay ahead).
    chase_speed: 4.0,
    // Chasers stop this close to you (they crowd you rather than stack up).
    crowd_gap: 1.1,
    jingle_rate: 32000,
)
