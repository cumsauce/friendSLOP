// The surf course's dressing (crates/side/src/features/surf.rs): neon and
// lights only, no colliders, so the ramps and the way you move are untouched.
// Edit and save: it's read again when the course next loads.
(
    // Each stage's neon colour (r, g, b, 0..1), in order; the last is reused.
    stage_colours: [
        (1.0, 0.25, 0.85),
        (0.2, 0.85, 1.0),
        (0.55, 1.0, 0.3),
        (1.0, 0.6, 0.15),
        (0.6, 0.35, 1.0),
    ],
    // The finish's colour (gold).
    finish_colour: (1.0, 0.85, 0.3),
    // How bright the neon glows (emissive multiplier).
    glow: 6.0,
    // The neon strip round each pad's edge: thickness (m).
    strip: 0.18,
    // A coloured light over each stage pad: intensity and range (m).
    pad_light: 250000.0,
    pad_light_range: 26.0,
    // The stage marker on each pad's back corner: post height (m), with one
    // glowing block per stage number stacked on it.
    marker_height: 4.0,
    // Lane lights floating beside the ramps: one every this many ridge
    // samples, this far (m) out past a face's foot, this far below the
    // ridge, and their size (m).
    lane_every: 5,
    lane_out: 3.0,
    lane_drop: 12.0,
    lane_size: 0.5,
    // The finish arch over the finish pad: height and width (m).
    arch_height: 8.0,
    arch_width: 18.0,
)
