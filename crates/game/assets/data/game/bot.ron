// The profiling bot's routes (crates/game/src/bot.rs): FRIENDSLOP_BOT=<route>
// with `host` drives your own body through one, then logs each step's frame
// times and the worst hitches and quits. Add FRIENDSLOP_PERF=1 for the usual
// 5 s report lines (they say which step the bot was on).
//
// Steps:
//   Start("<name>")            teleport to a FRIENDSLOP_START name: a map spot
//                              (bonfire, lake, village, ...) or a feature's
//                              start (fulton, penn_station, wastes, vessel, ...)
//   Walk([(x, z), ...])        walk through these points in turn
//   Run([(x, z), ...])         the same, running
//   WalkTo("<name>")           walk to a start's point
//   Follow("<name>")           walk through the starts <name>_0, <name>_1, ...
//                              (fulton_walk: Fulton St's way down)
//   Ride(from: "<stop>", to: "<stop>")
//                              board the train (or plane) standing at `from`
//                              (a stop's start name) and ride it to `to`
//   Wait(secs)  Spin(secs)     stand still / turn on the spot (draws every way)
//   Look(yaw, pitch)           face this way (degrees; pitch down)
//   Click                      click the nearest thing in reach
//   Repeat(n, [ ... ])         do these steps n times
(
    // Within this far (m) of a point counts as there.
    reach: 1.5,
    // No progress for this long (s): hop. For this long: give up on the step
    // (logged as GAVE UP) and go on.
    stuck_jump: 1.0,
    give_up: 6.0,
    // A frame over this many ms is a hitch (25 ms: a visible stutter at 60 fps).
    hitch_ms: 25.0,
    // How fast Spin turns (degrees a second), and whether every walk sprints.
    spin_degs: 360.0,
    // How fast the view swings round to face where it's going (degrees a
    // second); it walks the right way meanwhile.
    look_degs: 540.0,
    always_run: true,
    routes: {
        // The tour's hitch spots twice over: hitches only the first time
        // round are first-time loads (shaders, textures, models).
        "twice": [
            Repeat(2, [
                Start("bonfire"),
                Spin(4.0),
                WalkTo("village"),
                WalkTo("lake"),
                WalkTo("warehouse"),
                Spin(4.0),
                Start("chambers_st"),
                Ride(from: "chambers_st", to: "penn_station"),
                Start("vessel"),
                Spin(4.0),
            ]),
        ],
        // The tour's last stretch: the 1 train, then the flight.
        "tail": [
            Start("chambers_st"),
            Ride(from: "chambers_st", to: "penn_station"),
            Spin(4.0),
            Start("jfk"),
            Ride(from: "jfk", to: "miami"),
            Spin(4.0),
        ],
        // Just the flight to Miami (boarding at JFK).
        "flight": [
            Start("jfk"),
            Ride(from: "jfk", to: "miami"),
            Spin(4.0),
        ],
        // The commune on foot (checks the bot finds its way round the village).
        "commune": [
            Start("bonfire"),
            Wait(5.0),
            WalkTo("village"),
            // Round the landlord's yard walls, there and back.
            WalkTo("landlord"),
            WalkTo("lake"),
            WalkTo("landlord"),
            WalkTo("warehouse"),
            WalkTo("windmill"),
            WalkTo("bonfire"),
        ],
        // Everywhere once: the commune on foot, then each place by its way in.
        "tour": [
            Start("bonfire"),
            Spin(4.0),
            WalkTo("village"),
            Spin(4.0),
            WalkTo("lake"),
            WalkTo("warehouse"),
            Spin(4.0),
            Start("tunnels"),
            Spin(4.0),
            Start("fulton"),
            Spin(4.0),
            Start("world_trade_center"),
            Ride(from: "world_trade_center", to: "the_valley"),
            Spin(4.0),
            Start("chambers_st"),
            Ride(from: "chambers_st", to: "penn_station"),
            Spin(4.0),
            Start("jfk"),
            Ride(from: "jfk", to: "miami"),
            Spin(4.0),
            Start("vessel"),
            Spin(4.0),
            Start("wastes"),
            Spin(4.0),
            Start("bonfire"),
            Wait(3.0),
        ],
        // Down Fulton St level by level (the hunter never catches the bot),
        // then back up top: each level where you arrive and at its stairs.
        "fulton": [
            Start("fulton"),
            Follow("fulton_walk"),
            Start("bonfire"),
            Spin(4.0),
            Wait(3.0),
        ],
        // Stand on Fulton's first track level (level 3) through the 25 s
        // model listing of FRIENDSLOP_PERF=2.
        "fulton_line": [
            Start("fulton_3"),
            Spin(40.0),
        ],
        // The same levels by teleport: where you arrive and at the stairs.
        "fulton_hops": [
            Start("fulton"),
            Spin(3.0),
            Start("fulton_0"),
            Spin(3.0),
            Start("fulton_0_stairs"),
            Spin(2.0),
            Start("fulton_1"),
            Spin(3.0),
            Start("fulton_1_stairs"),
            Spin(2.0),
            Start("fulton_2"),
            Spin(3.0),
            Start("fulton_2_stairs"),
            Spin(2.0),
            Start("fulton_3"),
            Spin(3.0),
            Start("fulton_3_stairs"),
            Spin(2.0),
            Start("fulton_4"),
            Spin(3.0),
            Start("fulton_4_stairs"),
            Spin(2.0),
            Start("fulton_5"),
            Spin(3.0),
            Start("fulton_5_stairs"),
            Spin(2.0),
            Start("fulton_6"),
            Spin(3.0),
            Start("fulton_6_stairs"),
            Spin(2.0),
            Start("fulton_7"),
            Spin(3.0),
            Start("fulton_7_stairs"),
            Spin(2.0),
            Start("fulton_8"),
            Spin(3.0),
            Start("fulton_8_stairs"),
            Spin(2.0),
            Start("fulton_9"),
            Spin(3.0),
            Start("fulton_9_stairs"),
            Spin(2.0),
            Start("fulton_10"),
            Spin(3.0),
            Start("fulton_10_stairs"),
            Spin(2.0),
            Start("fulton_11"),
            Spin(3.0),
            Start("fulton_11_stairs"),
            Spin(2.0),
            Start("fulton_12"),
            Spin(3.0),
            Start("fulton_12_stairs"),
            Spin(2.0),
            Start("fulton_13"),
            Spin(3.0),
            Start("fulton_13_stairs"),
            Spin(2.0),
            Start("bonfire"),
            Spin(4.0),
            Wait(3.0),
        ],
        // In and out of places, again and again: every hop loads one area
        // and unloads another, which is where hitches hide.
        "borders": [
            Repeat(3, [
                Start("bonfire"),
                Wait(2.0),
                Start("penn_station"),
                Wait(2.0),
                Start("fulton"),
                Wait(2.0),
                Start("tunnels"),
                Wait(2.0),
                Start("wastes"),
                Wait(2.0),
            ]),
        ],
    },
)
