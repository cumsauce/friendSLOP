// Sites (#412, crates/base/src/sites.rs): where every mechanic lives. A site
// is asleep until somebody is within its reach: its creatures don't move, its
// sounds don't play, its HUD lines and key hints aren't shown.
// A new idea adds one line here and asks `sites::awake("<id>")`.
// Edit and save: the running game picks it up within a second.
(
    // A woken site stays awake until everyone is this far (m) outside its reach.
    linger: 15.0,
    // Each site: its id (what code asks for), its name (the journal), its
    // district, its area (data/base/areas.ron), its middle (`Spot("<map spot>", (dx, dz))` on the commune map,
    // or `At(x, z)` for places off it) and its reach from there
    // (`Round(radius)` or `Box(half x, half z)`, m).
    sites: [
        // The commune centre: the story hub.
        (id: "bonfire", name: "The bonfire", district: "commune", area: "commune", place: Spot("bonfire", (0.0, 0.0)), reach: Round(25.0)),
        (id: "landlord", name: "The landlord", district: "commune", area: "commune", place: Spot("landlord", (0.0, 0.0)), reach: Round(25.0)),
        (id: "parliament", name: "The Commune of Dave", district: "commune", area: "commune", place: Spot("parliament", (0.0, 0.0)), reach: Round(25.0)),
        (id: "vault", name: "The vault", district: "commune", area: "commune", place: Spot("vault", (0.0, 0.0)), reach: Round(25.0)),
        (id: "lectern", name: "The Tome of Uncancelling", district: "commune", area: "commune", place: Spot("lectern", (0.0, 0.0)), reach: Round(25.0)),
        (id: "arena", name: "The duel arena", district: "commune", area: "commune", place: Spot("arena", (0.0, 0.0)), reach: Round(30.0)),
        // The commune's creatures and things, out in the districts (#412).
        // North meadow, by the windmill: the crows (and their eggs) and a music box.
        (id: "crows", name: "The crows", district: "north meadow", area: "commune", place: Spot("windmill", (-9.0, 6.0)), reach: Round(30.0)),
        (id: "music_box_1", name: "The windmill's music box", district: "north meadow", area: "commune", place: Spot("windmill", (7.0, 5.0)), reach: Round(25.0)),
        // North forest: the bear, in the woodcutter's clearing.
        (id: "bear", name: "The bear", district: "north forest", area: "commune", place: Spot("forest_clearing", (3.0, 7.0)), reach: Round(30.0)),
        // Pond and picnic: the goat judges from the pond, the strays wait at the picnic.
        (id: "goat", name: "The judgmental goat", district: "pond", area: "commune", place: Spot("pond", (-5.0, -2.0)), reach: Round(25.0)),
        (id: "pets", name: "The strays", district: "pond", area: "commune", place: Spot("picnic", (0.0, 0.0)), reach: Round(30.0)),
        // West: the Wind totem on the hilltop, the Frost totem on the lake's north shore.
        (id: "totem_wind", name: "The Wind totem", district: "west valley", area: "commune", place: Spot("hill", (0.0, 0.0)), reach: Round(30.0)),
        (id: "totem_frost", name: "The Frost totem", district: "lake", area: "commune", place: Spot("lake", (0.0, -10.0)), reach: Round(25.0)),
        // Ruins: the second music box, by the quarry crane.
        (id: "music_box_2", name: "The quarry's music box", district: "ruins", area: "commune", place: Spot("quarry", (14.0, -4.0)), reach: Round(25.0)),
        // Places that already stood apart.
        (id: "fan_museum", name: "The Ceiling Fan Museum", district: "north east", area: "fan_museum", place: Spot("fan_museum", (0.0, 0.0)), reach: Round(45.0)),
        // The Michael Jackson Experience theatre: in through the brownstone
        // next to the surf one. Its lobby spot is the map's.
        (id: "michael_theater", name: "The Michael Jackson Experience", district: "new york", area: "michael_theater", place: At(230.0, -33.0), reach: Box(33.0, 25.0)),
        (id: "arcade_fps", name: "FRAG arena", district: "new york", area: "arcade_fps", place: At(500.0, -50.0), reach: Box(25.0, 25.0)),
        (id: "wendys", name: "Wendy's", district: "road east", area: "commune", place: Spot("wendys", (0.0, 0.0)), reach: Round(35.0)),
        (id: "warehouse", name: "The abandoned warehouse", district: "south", area: "commune", place: Spot("warehouse", (0.0, 0.0)), reach: Round(40.0)),
        (id: "lake", name: "The lake", district: "lake", area: "commune", place: Spot("lake", (0.0, 0.0)), reach: Round(30.0)),
        (id: "wreck", name: "The shipwreck", district: "lake", area: "commune", place: Spot("wreck", (0.0, 0.0)), reach: Round(45.0)),
        // New York: the city floor (x -90..90, z 116..330) and 25 m round it;
        // Penn Station, Fulton St and Miami are stacked over and under it.
        (id: "nyc", name: "New York City", district: "new york", area: "nyc", place: At(0.0, 223.0), reach: Box(115.0, 132.0)),
        // New York's points of interest, for the M map's labels (poi_*:
        // map-only pins, no mechanic asks for them).
        (id: "poi_surf", name: "The surf brownstone", district: "new york", area: "nyc", place: At(23.6, 239.0), reach: Round(12.0)),
        (id: "poi_michael_theater", name: "The Michael Jackson Experience", district: "new york", area: "nyc", place: At(23.6, 246.5), reach: Round(12.0)),
        (id: "poi_gong_chaw", name: "Gong Chaw boba", district: "new york", area: "nyc", place: At(26.0, 262.0), reach: Round(10.0)),
        (id: "poi_kung_fu_tee", name: "Kung Fu Tee boba", district: "new york", area: "nyc", place: At(26.0, 276.0), reach: Round(10.0)),
        (id: "poi_tiger_sugah", name: "Tiger Sugah boba", district: "new york", area: "nyc", place: At(26.0, 290.0), reach: Round(10.0)),
        (id: "poi_penn", name: "Penn Station", district: "new york", area: "nyc", place: At(-42.0, 281.0), reach: Round(20.0)),
        (id: "poi_oculus", name: "The Oculus", district: "new york", area: "nyc", place: At(-55.0, 230.0), reach: Round(15.0)),
        (id: "poi_wtc", name: "One World Trade Center", district: "new york", area: "nyc", place: At(57.0, 297.5), reach: Round(15.0)),
        (id: "poi_vessel", name: "The vessel", district: "new york", area: "nyc", place: At(-62.0, 172.5), reach: Round(12.0)),
        (id: "poi_pizza", name: "The pizza place", district: "new york", area: "nyc", place: At(-25.0, 177.0), reach: Round(10.0)),
    ],
)
