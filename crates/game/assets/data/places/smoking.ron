// Tuning for smoking (crates/places/src/features/smoking.rs).
// Edit and save: the running game picks it up within a second.
(
    // Seconds until a taken egg is laid again.
    egg_secs: 20.0,
    // Flirts with Paul per joint.
    love_for_joint: 3,
    // How long one smoke lasts.
    smoke_secs: 8.0,
)
