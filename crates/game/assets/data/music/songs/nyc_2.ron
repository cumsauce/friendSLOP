#![enable(implicit_some)]
// Nyc: song 2 (picked at random with the others). See moods.ron for what the fields mean.
// "Crosstown": house at a walking pace. Four on the floor, off-beat
// bass, Rhodes stabs on the "and"s, a flute singing a simple line and a
// cowbell on the corner in the hook.
(
    mood: "Nyc", band: "street",
    bpm: 112.0, swing: 0.0, key: 9,
    a: "BUSTLE_A", b: "BUSTLE_B", hook: "BUSTLE_HOOK",
    intensity: 0.6, odd: 0.0, modulate: 0.0, kime: 0.0,
    parts: [
        (play: Drums(groove: "House")),
        (play: Lane(lane: "shaker"), not: [Intro]),
        (play: Lane(lane: "Cowbell"), sections: [Hook]),
        (play: Bass(lines: ["HOUSE", "OCTAVE"]), inst: SubBass, bus: "bass", layer: [((not: [Intro]), 0.85), ((above: 0.4), 0.85)]),
        (play: Chords(comp: "HouseStab"), inst: EPiano),
        (play: Melody(style: "singer"), inst: Flute, not: [Intro]),
        (play: Pad(), inst: Strings, sections: [B, Breakdown]),
    ],
)
