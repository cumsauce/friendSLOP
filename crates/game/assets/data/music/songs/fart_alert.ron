#![enable(implicit_some)]
// FartAlert: song 1 (its own song). See moods.ron for what the fields mean.
// "Who Did That" (#324, written out): the shame alarm as a cartoon chase.
// A marching kit at full tilt, an oom-pah bass hopping octaves, clav
// stabs, a squealing mini-synth riff see-sawing over a siren of a
// progression, a cowbell clanging and a trumpet honking along a third
// below in the chorus.
(
    mood: "FartAlert", band: "street",
    bpm: 168.0, swing: 0.0, key: 6,
    a: "FART_A", b: "FART_B", hook: "FART_HOOK",
    intensity: 0.9, odd: 0.0, modulate: 0.0, kime: 0.0,
    parts: [
        (play: Drums(groove: "March", clap: true)),
        (play: Lane(lane: "Cowbell")),
        (play: Bass(lines: ["FART", "FART2"]), inst: SlapBass, bus: "bass"),
        (play: Chords(comp: "Stabs"), inst: Clav),
        (play: Melody(style: "riff"), inst: Mini),
        (play: Harmony(steps: -2), inst: MariachiTrumpet, sections: [Hook, B]),
    ],
)
