// Tuning for the Watcher's scraps (crates/side/src/features/clues.rs, #278).
// Edit and save: the running game picks it up within a second.
(
    // How long a piece you've just read stays on screen, in seconds.
    show_secs: 9.0,
    // How long the whole message stays on screen once it's complete.
    complete_secs: 20.0,
)
