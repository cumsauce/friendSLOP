// Tuning for kitty lemonade (crates/afterlife/src/features/kitty_lemonade.rs).
// Edit and save: the running game picks it up within a second.
(
    // A cat smells pee this far away (metres, plus its size).
    notice: 15.0,
    // Shortest distraction (seconds).
    min_secs: 10.0,
    // Longest distraction (seconds).
    max_secs: 30.0,
)
