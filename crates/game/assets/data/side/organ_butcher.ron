// Organ butcher (#217, crates/side/src/features/organ_butcher.rs): the
// chopping block in Wendy's backroom buys your cheapest organ for dollars.
// Edit and save: the running game picks it up within a second.
(
    // Organ value that buys one organ dollar (1: an organ is worth exactly its organ dollars).
    value_per_dollar: 1,
    // {organ}, {dollars} are filled in.
    sold_line: "the butcher weighs your {organ}, nods and slides you ${dollars} organ dollars. no questions. that's Wendy's.",
    empty_line: "the butcher looks you over. you have nothing left to sell.",
)
