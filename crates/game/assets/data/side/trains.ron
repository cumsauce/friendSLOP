// Trains (#321, crates/side/src/features/trains.rs).
// Each line runs between two stations; a train waits at both. Walk into the
// car, stand in it for `board_secs`, and it pulls out with you (into its
// tunnel, or off along its viaduct in the valley); then a short trip in a car rattling through the dark while the
// announcer (a retro speech synth) says the stop, and the other station's
// train comes out of its tunnel with you in it. Add a line to add a train.
// Edit and save: the running game picks it up within a second.
(
    // Seconds standing in a waiting train before it leaves with you.
    board_secs: 2.0,
    // Seconds the train takes to pull out of the station into its tunnel.
    depart_secs: 6.0,
    // Seconds in the ride car between the stations.
    ride_secs: 9.0,
    // Seconds the train takes to come out of the tunnel and stop.
    arrive_secs: 7.0,
    // Seconds a train that left without riders stays away before the next comes in.
    away_secs: 4.0,
    // How far into its tunnel the train goes (m, its middle from the platform).
    run_out: 32.0,
    // Where the ride cars hang (x, y, z), deep under the city: one per line,
    // 30 m apart along x. Nobody sees them from outside.
    ride_at: (40.0, -300.0, 300.0),
    // How dark a ride car and an underground hall are: data/base/place_looks.ron
    // (train_ride, train_hall).
    // The announcer's voice: pitch and speed.
    voice: (80.0, 0.9),
    // Shown while a train waits to leave with you.
    boarding_line: "stand clear of the closing doors, please.",
    lines: [
        (
            name: "PATH",
            // How far the train goes before it's gone (m): far enough to be
            // out of sight along the valley's viaduct.
            run_out: Some(95.0),
            // Exactly two stops, in round brackets: the train runs between them.
            stops: (
                (
                    name: "the valley",
                    // The car's middle (x, z) at the platform, and which way it
                    // points (degrees about up): it leaves along its +x into the
                    // tunnel, and the platform is on its +z side.
                    at: (-10.0, 66.0),
                    yaw: 0.0,
                    // On the city floor (true) or on the valley's ground (false).
                    city: false,
                    // Raised this far over the ground (m), its track off on a viaduct
                    // (the station model is made for 2).
                    raise: 2.0,
                    // How far under the floor the track is (m): 0 on the surface,
                    // else an underground hall (its model is 7 m tall).
                    depth: 0.0,
                    // Said on the way to this stop.
                    announce: "This is a Valley bound PATH train. Next and last stop: the Valley. Mind the gap, and mind the goats.",
                ),
                (
                    name: "World Trade Center",
                    // Under the Oculus hall: its stairs come up inside it.
                    at: (-55.0, 226.0),
                    yaw: 0.0,
                    city: true,
                    depth: 7.0,
                    announce: "This is a World Trade Center bound PATH train. Next and last stop: World Trade Center.",
                ),
            ),
        ),
        (
            // The flight to Miami Music Week (#345): the same as a train, but a
            // plane off a gate that rolls out, takes off and climbs away.
            name: "Flight 305",
            vehicle: Plane,
            // How far it rolls and flies before it's gone (m), where it leaves
            // the ground (m along) and how steeply it climbs (m up per m).
            run_out: Some(140.0),
            lift_off: 40.0,
            climb: 0.3,
            stops: (
                (
                    name: "JFK",
                    // At the city's north end, in the trees over the rim.
                    at: (40.0, 134.0),
                    yaw: 0.0,
                    city: true,
                    announce: "Welcome aboard flight three oh five to Miami. Please fasten your seatbelts. It is music week. Godspeed.",
                ),
                (
                    name: "Miami",
                    at: (-40.0, 184.0),
                    yaw: 0.0,
                    city: false,
                    // Miami floats far above New York (data/side/miami.ron: its ground).
                    floor: Some(1500.0),
                    announce: "Ladies and gentlemen, we have begun our descent into Miami. Local time is party o'clock. Factory Town is to your right.",
                ),
            ),
        ),
        (
            // To Penn Station (#357): Rose Pizza and its bathroom
            // (data/side/penn.ron). A plain subway car from the trees at the
            // city's north end (across from JFK) to the concourse, which
            // floats high over New York like Miami.
            name: "1 train",
            stops: (
                (
                    name: "Chambers St",
                    at: (-40.0, 134.0),
                    yaw: 0.0,
                    city: true,
                    announce: "This is a Penn Station bound 1 train. The next stop is thirty fourth street, Penn Station. Transfer to the Long Island Rail Road. Good luck in the bathroom.",
                ),
                (
                    name: "Penn Station",
                    at: (-40.0, 260.0),
                    yaw: 0.0,
                    city: false,
                    // Its concourse floats this high over New York (penn.ron).
                    floor: Some(1000.0),
                    announce: "This is a downtown 1 train. Next stop, Chambers Street. Stand clear of the closing doors, please.",
                ),
            ),
        ),
    ],
)
