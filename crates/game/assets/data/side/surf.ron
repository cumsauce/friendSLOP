// The surf map in the brownstone (#306, crates/side/src/features/surf.rs;
// the air numbers are read by the walker in crates/play/src/features/fps.rs).
// Edit and save: the running game picks it up within a second.
(
    // The brownstone's front door at the top of its stoop (x, z): walk into
    // it and you're on the surf map's start pad.
    door: (23.6, 239.0),
    // How close (metres) to the door takes you in.
    door_reach: 1.8,
    // The neon SURF sign over the door (x, y, z), facing the avenue.
    sign_at: (22.6, 5.9, 238.8),
    // Where you come back out: the sidewalk in front of the stoop (x, z).
    street: (18.0, 238.0),
    // Where the surf hall is (its start pad's top, x, y, z): high over the
    // city, bigger on the inside than the brownstone.
    hall_at: (0.0, 700.0, 320.0),
    // Fall this far (metres) below the start pad and you're back on it.
    fall_below: 44.0,
    // Air control inside the hall. Out in the world the walker uses
    // 10 (acceleration, per second), 0.76 (m/s you may add towards
    // where you steer) and 30 (top speed, m/s). Surf servers crank the
    // first one way up: strafe into a ramp's face and you glide along it.
    air_accel_hz: 120.0,
    air_max_wish: 0.76,
    max_speed: 45.0,
    // Shown when you walk in.
    enter_line: "SURF: drop off the pad, hold strafe into a ramp's side and steer with the mouse. don't press forward.",
    // Shown when you fall off ({secs} is how long that run lasted).
    wipeout_line: "wiped out after {secs} s. back to the top.",
    // Shown on the finish pad ({secs} this run, {best} your best this game).
    finish_line: "FINISH: {secs} s (best {best} s)",
    // The posts' labels.
    exit_label: "Leave (back to the street)",
)
