// Kori coins (#382): what each gross thing pays. Spend them on the claw
// machine by the gambling table (data/side/kori.ron has its price).
(
    // A fart, on purpose (F) or bursting out.
    fart: 1,
    // On top of that, when an NPC was near enough to be shamed.
    shameful_fart: 2,
    // Eating the feces out of a toilet.
    feces: 5,
)
