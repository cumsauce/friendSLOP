// The soundtrack's mix: one entry per mixer bus. The bus names are the band's
// slots (drums, bass, keys, lead, pad, perc, brass, guitar); instruments.ron
// puts each instrument on one of them.
// Edit and save: the running game picks it up within a second.
//
// Each bus, in the order its chain runs. Every field is optional: one left out is its
// default (trim 1, no pump, no EQ, every effect off: None).
//   transient  transient shaper: (attack, sustain), about -1..1; attack > 0 snaps the
//            hits, sustain > 0 lifts the tails.
//   eq       up to six bands, in order: Hp(hz, q), Lp(hz, q), Peak(hz, q, db),
//            LowShelf(hz, db), HighShelf(hz, db), Bp(hz, q). Each part keeps
//            some body in the 200-300 Hz low mids; the scoops are gentle and
//            the presence boosts small.
//   crush    bit and sample-rate crush, lo-fi / jungle grit: (bits, rate Hz, mix),
//            e.g. Some((8.0, 11025.0, 0.4)).
//   trim     bus level: the kit is synthesized hot, the band sits up with it.
//   pump     how deep the bus ducks under a full-strength kick: pads and bass
//            breathe most, the lead least, the drums and percussion not at all.
//   drive    saturation: (amount 0..1, tone 0..1). A soft clipper at twice the
//            sample rate, level-matched so it thickens without getting louder;
//            tone is the low-pass after it (0 dark ~1.5 kHz, 1 open ~18 kHz).
//   comp     compressor: (threshold dB, ratio, attack ms, release ms, mix 0..1).
//            RMS, stereo-linked; mix below 1 blends the squashed bus with the
//            dry one (parallel compression: ghost notes and hats come up, the
//            hits keep their snap).
//   autopan  a suitcase-piano tremolo: (rate Hz, depth).
//   chorus   (rate Hz, centre ms, depth ms, mix).
//   phaser   four-stage phaser: (rate Hz, depth 0..1, feedback -0.9..0.9, mix).
//   filter   a resonant bus filter: (Lp or Hp, cutoff Hz, q), smoothed so the
//            cutoff can sweep (a filtered breakdown that opens on the drop).
//   width    stereo width: (width, mono below Hz). Width 0 is mono, 1 as is,
//            up to 2 wide; everything below the frequency is summed to mono
//            (a phase-safe crossover; 0 leaves the lows alone).
//
// echo (after the buses): the shared echo send, which a song file can
// replace with its own `echo: Some((...))` (left-out fields as here).
//   division  Sixteenth, TripletEighth, Eighth, TripletQuarter,
//             DottedEighth, Quarter, DottedQuarter or Half, at the song's tempo.
//   pingpong  true: repeats bounce left-right; false: each side repeats itself.
//   feedback  how much of each repeat comes back (0..0.95).
//   tone      brightness of the repeats (0 dark .. 1 untouched).
//
// A song can change this mix for itself only: `mix:` in its song file overrides any field
// of any bus, partially (`mix: { "bass": (drive: (0.7, 0.4)), "pad": (chorus: None) }`);
// every other field and every other song keeps what's here. Changing songs crossfades the
// two mixes.
// A song's `mix_auto:` lanes move these settings over time by name (see moods.ron):
//   trim, pump, eq.<band>.hz / .q / .db (bands count from 0), transient.attack / .sustain,
//   crush.bits / .rate / .mix, drive.amount / .tone, comp.threshold / .ratio / .attack /
//   .release / .mix, autopan.rate / .depth, chorus.rate / .centre / .depth / .mix,
//   phaser.rate / .depth / .feedback / .mix, filter.cutoff / .q, width.amount /
//   .mono_below (only the width moves live), and on the "master" bus wet / echo (reverb
//   and echo sends, 1 as mixed) and feedback (the echo's repeats).
//   A lane on an effect that's off on that bus does nothing.
(
    buses: {
        "drums": (
            // Up from 1.0 to make up what the parallel comp takes off the hits.
            trim: 1.4,
            pump: 0.0,
            eq: [Hp(32.0, 0.7), Peak(110.0, 1.0, 1.5), Peak(420.0, 1.0, -1.0), HighShelf(9000.0, -0.5)],
            autopan: None,
            chorus: None,
            transient: Some((0.35, 0.0)),
            width: Some((1.0, 120.0)),
            drive: Some((0.2, 0.85)),
            comp: Some((-28.0, 6.0, 3.0, 90.0, 0.45)),
        ),
        "bass": (
            trim: 1.55,
            pump: 0.35,
            eq: [
                Hp(30.0, 0.7),
                LowShelf(95.0, 2.5),
                Peak(240.0, 1.0, 1.5),
                Peak(450.0, 1.0, -1.5),
                Peak(1700.0, 1.2, 1.0),
            ],
            autopan: None,
            chorus: None,
            width: Some((1.0, 120.0)),
            drive: Some((0.55, 0.45)),
        ),
        "keys": (
            trim: 1.6,
            pump: 0.22,
            eq: [
                Hp(90.0, 0.7),
                Peak(260.0, 0.9, 2.0),
                Peak(560.0, 0.9, -1.0),
                Peak(1800.0, 0.9, 1.0),
                HighShelf(4500.0, 0.5),
            ],
            autopan: Some((4.2, 0.22)),
            chorus: Some((0.55, 6.5, 2.2, 0.5)),
            width: Some((1.3, 150.0)),
        ),
        "lead": (
            trim: 1.5,
            pump: 0.1,
            eq: [
                Hp(130.0, 0.7),
                Peak(300.0, 0.9, 1.5),
                Peak(750.0, 1.0, -0.5),
                Peak(2200.0, 0.8, 1.5),
                Lp(12000.0, 0.7),
            ],
            autopan: None,
            chorus: None,
        ),
        "pad": (
            trim: 1.6,
            pump: 0.4,
            eq: [Hp(140.0, 0.7), Peak(280.0, 0.8, 2.0), Peak(620.0, 0.8, -2.0), HighShelf(5000.0, 0.5)],
            autopan: None,
            chorus: Some((0.32, 9.0, 3.5, 0.7)),
            phaser: Some((0.12, 0.6, 0.35, 0.25)),
            width: Some((1.5, 150.0)),
        ),
        "perc": (
            trim: 1.45,
            pump: 0.0,
            eq: [Hp(200.0, 0.7), Peak(350.0, 0.9, 1.0), Lp(12000.0, 0.7)],
            autopan: None,
            chorus: None,
        ),
        "brass": (
            trim: 1.6,
            pump: 0.22,
            eq: [Hp(120.0, 0.7), Peak(300.0, 0.9, 1.5), Peak(520.0, 0.9, -1.0), Peak(2400.0, 0.9, 1.0)],
            autopan: None,
            chorus: Some((0.8, 5.5, 1.6, 0.45)),
            width: Some((1.3, 150.0)),
        ),
        // The nylon guitar's body: the air resonance and the top plate, the
        // boxy low mids pulled out, a little clarity up top.
        "guitar": (
            trim: 1.7,
            pump: 0.18,
            eq: [
                Hp(75.0, 0.7),
                Peak(105.0, 1.4, 2.0),
                Peak(220.0, 1.2, 1.5),
                Peak(420.0, 0.9, -3.0),
                Peak(2500.0, 0.8, 0.5),
                HighShelf(6000.0, -4.0),
            ],
            autopan: None,
            chorus: None,
        ),
    },
    echo: (
        division: DottedEighth,
        pingpong: true,
        feedback: 0.42,
        tone: 0.45,
    ),
)
