// Tuning for discord friends (crates/side/src/features/discord_friends.rs).
// Edit and save: the running game picks it up within a second.
(
    // Chats it takes for a friend to start dating you.
    hearts_to_date: 5,
    // A friend only counts one chat from you this often (seconds).
    chat_cooldown: 1.5,
)
