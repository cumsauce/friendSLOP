// Tuning for shipwreck (crates/side/src/features/shipwreck.rs).
// Edit and save: the running game picks it up within a second.
(
    // How long a beaten pirate stays down.
    yield_secs: 90.0,
    // Chance a pirate's swing knocks you back.
    knockback_chance: 0.35,
    // How far a knockback sends you.
    knockback: 3.0,
    // Doubloons from one helping of treasure.
    haul: 25,
)
