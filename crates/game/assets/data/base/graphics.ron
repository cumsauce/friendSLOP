// Video settings (crates/base/src/graphics.rs). Edit and save: applies live.
(
    // Resolution "Fast" on desktop (the Low preset): the world renders at this
    // fraction of the window's width and height and is stretched to fit, so a
    // weak GPU (a Steam Deck) shades fewer pixels. 0.7 is about half the pixels.
    // The menus and HUD stay sharp. 1 turns it off.
    fast_scale: 0.7,
    // Ambient occlusion's samples per pixel: Low, Medium or High. It's blurred
    // afterwards, so Low looks the same in play and costs about half of High
    // (1.4 ms against 2.6 ms of GPU time a frame at 2560x1440). Read when
    // ambient occlusion is switched on or the game starts.
    ssao_quality: Low,
    // Desktop: the most pixels, in millions, the world is ever rendered at.
    // A window with more (a Retina screen has four times the pixels of its
    // size: fullscreen on a 14" MacBook is 5.9) renders at this many and is
    // stretched to fit; the menus and HUD stay sharp. 1920x1080 is 2.1,
    // 2560x1440 is 3.7. 0 = no cap.
    max_megapixels: 2.6,
    // The sun's shadow cascades (the Shadows option: Long, Short or Off).
    // count: shadow maps (every caster is drawn once per cascade, ~0.8-1 ms
    // each at 2560x1440); first: how far the sharpest one reaches (m);
    // distance: how far shadows reach at all (m). Every preset uses Long.
    long_shadows: (count: 3, first: 12.0, distance: 80.0),
    short_shadows: (count: 2, first: 12.0, distance: 40.0),
    // Eye adaptation (desktop with Bloom on; browsers and Low keep a fixed
    // exposure). The camera meters the scene's average brightness (log2
    // luminance; daylight is about `outdoor`) and moves its exposure:
    // brighten/darken: the most it follows a darker / brighter scene, in stops
    // (a shop or Penn Station comes back up to near daylight);
    // fade_start/fade_end: from this many stops under daylight the boost fades,
    // and past fade_end it's gone, so places dark on purpose (the warehouse,
    // Fulton St, night) stay dark;
    // speed_*: how fast it adapts, stops per second.
    auto_exposure: (
        outdoor: -1.5,
        brighten: 2.0,
        darken: 0.5,
        fade_start: 3.0,
        fade_end: 5.0,
        speed_brighten: 1.2,
        speed_darken: 1.8,
    ),
)
