// The surf map in the brownstone (#306, crates/side/src/features/surf.rs;
// the air numbers are read by the walker in crates/play/src/features/fps.rs).
// Edit and save: the running game picks it up within a second.
(
    // The brownstone's front door at the top of its stoop (x, z): walk into
    // it and you're on the surf map's start pad.
    door: (23.6, 239.0),
    // How close (metres) to the door takes you in.
    door_reach: 1.8,
    // The neon SURF sign over the door (x, y, z), facing the avenue.
    sign_at: (22.6, 5.9, 238.8),
    // Where you come back out: the sidewalk in front of the stoop (x, z).
    street: (18.0, 238.0),
    // Where the surf course is (its start pad's top, x, y, z): high in the
    // sky far east of everything, bigger on the inside than the brownstone.
    hall_at: (4000.0, 900.0, 0.0),
    // Fall this far (metres) below the start pad and you're back on it
    // (a backstop: falling off a stage puts you back on its pad first).
    fall_below: 700.0,
    // Air control inside the hall. Out in the world the walker uses
    // 10 (acceleration, per second), 0.76 (m/s you may add towards
    // where you steer) and 30 (top speed, m/s). Surf servers crank the
    // first one way up: strafe into a ramp's face and you glide along it.
    air_accel_hz: 120.0,
    air_max_wish: 0.76,
    max_speed: 45.0,
    // Shown when you walk in.
    enter_line: "SURF: five stages, each pad is a checkpoint. drop off the pad, hold strafe into a ramp's side and steer with the mouse. don't press forward.",
    // Shown when you fall off ({secs} is how long that run lasted).
    wipeout_line: "wiped out after {secs} s. back to the top.",
    // Shown on the finish pad ({secs} this run, {best} your best this game).
    finish_line: "FINISH: {secs} s (best {best} s)",
    // The posts' labels.
    exit_label: "Leave (back to the street)",
    // The hall's inside relative to the start pad (min, max): air control
    // is surf's inside it.
    hall: ((-140.00, -725.00, -2231.00), (602.00, 40.00, 124.00)),
    // Every ramp is a ridge with 59 degree faces: half its width and its
    // height, and how many pieces each span between two points is cut into.
    ramp_half_width: 6.0,
    ramp_height: 10.0,
    ramp_samples: 4,
    // Fall this far below the lowest ridge of your stage and you're back on
    // its pad.
    stage_fall: 18.0,
    // The course (made with the surf-hall model in the modeler): each stage
    // is its pad (centre, size) and its ramps, each the ridge's points
    // (x, y, z), a smooth curve through them. The first pad is the start.
