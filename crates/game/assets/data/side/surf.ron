// The surf map in the brownstone (#306, crates/side/src/features/surf.rs;
// the air numbers are read by the walker in crates/play/src/features/fps.rs).
// Edit and save: the running game picks it up within a second.
(
    // The brownstone's front door at the top of its stoop (x, z): walk into
    // it and you're on the surf map's start pad.
    door: (23.6, 239.0),
    // How close (metres) to the door takes you in.
    door_reach: 1.8,
    // The neon SURF sign over the door (x, y, z), facing the avenue.
    sign_at: (22.6, 5.9, 238.8),
    // Where you come back out: the sidewalk in front of the stoop (x, z).
    street: (18.0, 238.0),
    // Where the surf course is (its start pad's top, x, y, z): high in the
    // sky far east of everything, bigger on the inside than the brownstone.
    hall_at: (4000.0, 900.0, 0.0),
    // Fall this far (metres) below the start pad and you're back on it
    // (a backstop: falling off a stage puts you back on its pad first).
    fall_below: 2850.0,
    // Movement inside the hall, from a Counter-Strike surf server (Source
    // engine) converted at 1 Hammer unit = 0.0254 m (a CS player is 72 u,
    // 1.83 m, tall). Out in the world the walker uses 10 / 0.76 / 30 / 14
    // / 20 / 12 / 2.54 and its own walk speed. Ramps steeper than 45
    // degrees aren't ground: you slide along them in the air, velocity
    // clipped onto the face, no friction (Source's ClipVelocity), so strafe
    // into a ramp's face, steer with the mouse, and every turn adds speed.
    // sv_airaccelerate 150 (surf servers; 10 in plain CS).
    air_accel_hz: 150.0,
    // The 30 u/s cap on the wish speed in the air (0.762 m/s).
    air_max_wish: 0.762,
    // sv_maxvelocity 3500 u/s (88.9 m/s).
    max_speed: 88.9,
    // sv_gravity 800 u/s^2 (20.32 m/s^2).
    gravity: 20.32,
    // sv_accelerate 10 (surf servers; 5.5 in CS:GO).
    ground_accel_hz: 10.0,
    // sv_friction 4. Ground friction here is this times the surface's own
    // coefficient (0.5 by default), so 8 gives CS's 4.
    friction_hz: 8.0,
    // sv_stopspeed 75 u/s (1.905 m/s).
    stop_speed: 1.905,
    // Run speed with the knife out, 250 u/s (6.35 m/s): the wish speed
    // the air acceleration scales with (walk/run don't matter in here).
    wish_speed: 6.35,
    // Shown when you walk in.
    enter_line: "SURF: seven stages, each pad is a checkpoint. drop off the pad, hold strafe into a ramp's side and steer with the mouse. don't press forward. {surf_reset}: tap for your checkpoint, hold for the start.",
    // Shown when you fall off ({secs} is how long that run lasted).
    wipeout_line: "wiped out after {secs} s. back to the top.",
    // Shown on the finish pad ({secs} this run, {best} your best this game).
    finish_line: "FINISH: {secs} s (best {best} s). {surf_reset} to surf it again.",
    // How long (s) you hold the restart button to go back to the start (a tap
    // goes to your checkpoint).
    restart_hold: 0.6,
    // The posts' labels.
    exit_label: "Leave (back to the street)",
    // The hall's inside relative to the start pad (min, max): air control
    // is surf's inside it.
    hall: ((-140.00, -2900.00, -2600.00), (5700.00, 600.00, 124.00)),
    // Every ramp is a ridge with 59 degree faces: half its width and its
    // height, and how many pieces each span between two points is cut into.
    ramp_half_width: 6.0,
    ramp_height: 10.0,
    ramp_samples: 4,
    // The ramps drawn at run time take the hall's ramp texture (the stripes
    // that show your speed): base colour, normal, metal/rough, emissive, and
    // the metres one repeat covers. Re-exporting the hall renames the files.
    ramp_textures: (
        "textures/surf-ramp-base_color-85e446c91076ba07.ktx2",
        "textures/surf-ramp-normal-d2c21eb7bcd36316.ktx2",
        "textures/surf-ramp-metal_rough-e9a9cc351dc046a7.ktx2",
        "textures/surf-ramp-emissive-dd1f739b70e2e384.ktx2",
    ),
    ramp_tile: 4.0,
    // Fall this far below the lowest ridge of your stage and you're back on
    // its pad.
    stage_fall: 18.0,
    // A checkpoint (a stage's pad, and the finish) counts you up to this high
    // above it (m) and this far past its edges (m): fly over it and it counts.
    checkpoint_reach: (30.0, 3.0),
    // The course (stages: pads and ramps' ridge points; the finish pad; the pads'
    // solid boxes) is in the modeler map, `maps/surf.map.json` (the `surf-map`
    // document: `Pad`, `Ridge` and `course_block` markers). Read by
    // `rules::surf::course`; edit it in the modeler.
    // Speed checks: gaps between the end of one ramp and the start of the
    // next you only clear carrying speed (stage, ramp: the gap after that
    // ramp of that stage, both counted from 0). Too slow and you drop and
    // fall back to the stage's pad. The speed needed comes from the ramps
    // (rules::surf::speed_needed): leave a ramp's end along its ridge and
    // land on the upper half of the next one's face. Now: stage 1 after its
    // second ramp (25 m, needs ~36 m/s), stage 3 after its second (25 m, ~36),
    // stage 4 after its second (30 m, 12 m down, ~37), stage 5 after its
    // first (25 m, ~35). A clean run carries 45-60 m/s there.
    // (They are `SpeedGap` markers in the map files now.)
    // The city the course weaves through, generated from the ramps (the
    // same on every peer): tall towers both sides, building sites just under
    // a ramp's side (fall off onto one, hit its kicker and get back on),
    // cranes on roofs and girders across, high over the ramp.
    city: (
        // Change it for a different city.
        seed: 306,
        // A building every this many metres along each ramp (min, max).
        every: (14.0, 30.0),
        // Gap (m) between a ramp's face and a tall tower (min, max).
        gap: (3.0, 9.0),
        // A tower's width and depth (min, max).
        size: (12.0, 24.0),
        // How far a tall tower's roof rises above the ridge beside it (min, max).
        rise: (6.0, 70.0),
        // The towers' feet (hall y).
        floor: -720.0,
        // Chance a spot is a building site just under the ramp.
        site_chance: 0.25,
        // How far a site's roof is below the ramp's face bottoms (min, max).
        site_drop: (4.0, 7.0),
        // A site's kicker: length, width, height.
        kicker: (8.0, 6.0, 3.5),
        // Chance a tall tower has a crane on top, and its mast and jib.
        crane_chance: 0.2,
        crane: (18.0, 34.0),
        // Chance of towers on both sides with a girder across.
        girder_chance: 0.12,
        // A girder's underside stays this far (m) above the ridge.
        girder_clear: 9.0,
        // Keep towers this far (m) from a pad's middle.
        pad_clear: 13.0,
    ),
)
