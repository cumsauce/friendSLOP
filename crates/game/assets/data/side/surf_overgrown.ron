        (x: (4130.0, 4390.0), z: (-2010.0, -1880.0), water_y: -1143.4, roof_y: -1058.4,
         column: 4.0, column_every: 26.0, rib_every: 26.0, broken: 0.45, balcony_y: -1052.0, escalators: 3),
    ],
    // Hand-placed giant trees (model 1..3, x, z, scale, heading): trunk
