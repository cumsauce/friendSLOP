#![enable(implicit_some)]
// Nyc: song 1 (its own song). See moods.ron for what the fields mean.
// "Stoop Sitting": boom-bap. A lazy swung beat, dusty Rhodes holding
// minor sevenths, the upright under it, a short vibes riff, and a muted
// horn answering in the hook and the bridge. Few parts, lots of air.
(
    mood: "Nyc", band: "street",
    bpm: 90.0, swing: 0.2, key: 2,
    a: "BOOM_A", b: "BOOM_B", hook: "BOOM_HOOK",
    intensity: 0.55, odd: 0.0, modulate: 0.0, kime: 0.0,
    parts: [
        (play: Drums(groove: "BoomBap")),
        (play: Bass(lines: ["BOOM", "BOOM2"]), inst: Upright, bus: "bass", layer: [((not: [Intro]), 0.8), ((above: 0.4), 0.8)]),
        (play: Chords(comp: "Dusty"), inst: DustyKeys),
        (play: Melody(style: "riff"), inst: Vibes, not: [Intro]),
        (play: Answer(chance: (0.35, 0.2)), inst: SoftBrass, sections: [Hook, B], register: (55, 70)),
    ],
)
