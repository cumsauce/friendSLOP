        (stage: 12, name: "Mall swing", calm: false, points: [(4092.35, -1076.87, -1951.50), (4101.41, -1078.23, -1951.50), (4110.47, -1079.59, -1951.64), (4119.48, -1080.94, -1952.51), (4128.34, -1082.30, -1954.34), (4136.89, -1083.66, -1957.29), (4145.10, -1085.02, -1961.11), (4153.01, -1086.37, -1965.52), (4161.05, -1087.73, -1969.71), (4169.46, -1089.09, -1973.07), (4178.23, -1090.45, -1975.31), (4187.22, -1091.81, -1976.46), (4196.27, -1093.17, -1976.80), (4205.33, -1094.53, -1976.81), (4214.39, -1095.89, -1976.81), (4226.76, -1097.74, -1976.81)]),
