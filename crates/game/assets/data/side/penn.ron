// Penn Station (#357, #352, crates/side/src/features/penn.rs).
// Walk in the glass doors under the Garden on 7th Ave (the city map's `penn`
// spot), or ride the 1 train from its stop in the trees at the city's north
// end. The concourse (Rose Pizza and its bathroom, the NJ Transit side and
// the LIRR side) floats high over New York like Miami does.
// Edit and save: the running game picks it up within a second.
(
    // The stop in trains.ron the concourse is built round (its frame is the model's origin).
    stop: "Penn Station",
    // Stand this close (m) to the bathroom door and the person in front of you starts talking.
    queue_reach: 2.0,
    // Seconds each line of the conversation stays up.
    line_secs: 3.2,
    // Seconds of silence while they're in there.
    silence_secs: 15.0,
    // Walk this far (m) from the door once you've been and the next person is in line.
    reset_dist: 12.0,
    // Shown when you walk into Rose Pizza's corner.
    pizza_line: "ROSE PIZZA. the slice has been under the heat lamp since the nixon administration. it's perfect.",
    // Shown when you buy a slice.
    slice_line: "you fold it. grease runs to your elbow. the 7:42 to ronkonkoma is boarding on track 19.",
    // Shown when the person goes in, and when the silence is over.
    gone_in_line: "they go in. the door clicks. you're alone with what they said.",
    free_line: "the bathroom's free.",
    // Shown when you try the stall before it's your turn, and when you use it.
    occupied_line: "occupied. someone knocks back from inside, which is worse.",
    used_line: "you used the Penn Station bathroom. you will never speak of this.",
    // Shown when you look in the mirror (it's tiny and filthy).
    mirror_line: "the mirror is the size of a postcard and coated in something. a blur that might be you looks back.",
    // What the person in front of you says, one conversation per visit, in turn.
    // "you:" lines are what you hear yourself say back.
    conversations: [
        [
            "them: you ever notice the trains here don't go anywhere? they just go.",
            "you: they go to new jersey.",
            "them: that's what i said.",
            "them: my uncle was a pigeon. not like, spiritually.",
        ],
        [
            "them: is this the line for the bathroom or for the other thing?",
            "you: what other thing?",
            "them: exactly. good. we're on the same page.",
            "them: don't eat the rose pizza after 2am. eat it at 1:59.",
        ],
        [
            "them: i've been in this line since they tore the old station down.",
            "you: that was 1963.",
            "them: and i've never once been the front.",
            "them: today's my day. i can feel it in my knees.",
        ],
        [
            "them: what's your sign?",
            "you: uh, the bathroom sign?",
            "them: classic restroom. i knew it. you've got restroom energy.",
            "them: anyway i'm a track 13. we don't get along.",
        ],
        [
            "them: i'm not going in there to pee.",
            "you: ok.",
            "them: i'm going in there to make a phone call to 1997.",
            "them: wish me luck.",
        ],
    ],
    // Stand this close (m) to the street doors or the way-out stairs (EXIT 7 AV) and you go through.
    door_reach: 1.6,
    // Shown when you walk into the NJ Transit side, and into the LIRR side.
    njt_line: "NJ TRANSIT. it's cold. every gate is chained. something is on fire and nobody is surprised.",
    lirr_line: "LIRR. warm light, a wood ceiling, free charging, a bottle refill, a lounge. the trains are on time. this can't last.",
    // How bright the trash fires burn (lumens) and how much they flicker (0..1).
    fire_lumens: 9000.0,
    fire_flicker: 0.6,
)
