#![enable(implicit_some)]
// Bodega: song 2 (picked at random with the others). See moods.ron for what the fields mean.
// "Ranchera de la Esquina": a ranchera vals in 3/4. The upright takes
// the "oom" on one, the nylon guitar the "pah-pah", two mariachi
// trumpets sing in thirds and strings swell under the bridge.
(
    mood: "Bodega", band: "vals",
    bpm: 150.0, swing: 0.0, key: 2, steps: 12, beats: 3,
    a: "VALS_A", b: "VALS_B", hook: "VALS_HOOK",
    intensity: 0.5, odd: 0.0, modulate: 0.0, kime: 0.0,
    parts: [
        (play: Drums(groove: "Vals")),
        (play: Bass(lines: ["VALS", "VALS5"]), inst: Upright),
        (play: Chords(comp: "OomPah"), inst: Guitar, bus: "guitar", layer: [((), 0.55)]),
        (play: Melody(style: "mariachi"), inst: MariachiTrumpet, not: [Intro]),
        (play: Harmony(steps: -2), inst: MariachiTrumpet, not: [Intro]),
        (play: Pad(), inst: Strings, sections: [B, Breakdown]),
    ],
)
