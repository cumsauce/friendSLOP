// How a line is said: each mood is one `Delivery` (crates/speech/src/synth.rs).
// Lines and voices pick a mood by name: a voice's `mood` in its own data file, or a
// trailing `[mood]` on a line of text. Edit and save: the running game picks it up
// within a second. Starting points come from the emotional-speech rules of Cahn (1989),
// Murray & Arnott (HAMLET) and Burkhardt & Sendlmeier (2000): mean pitch, pitch range,
// rate, stress length, voice quality (open quotient, tilt, breath, jitter), precision.
//
// Fields:
//   pitch_mult: multiplies the voice's pitch
//   range_mult: multiplies how far the pitch moves for accents and sentence ends
//   rate_mult: multiplies the speed
//   stress_len: how much longer stressed sounds are
//   declination: semitones the pitch sinks over a sentence
//   oq: glottal open quotient: low is tense and bright, high is lax and soft
//   tilt: 0 bright .. 1 dull source
//   breath: breathy noise, 0..1
//   jitter: random change of each pitch period (0.01 is one percent)
//   shimmer: random change of each period's loudness
//   drift: slow wander of pitch, semitones
//   vibrato_depth: semitones, on held vowels
//   vibrato_rate: Hz
//   precision: how far vowels reach their targets: <1 mumbles, >1 enunciates
//   final_rise: semitones added where a sentence ends
//   pause_mult: multiplies pauses
//   burst: loudness of stop bursts
//   nasal: nasal colour on vowels, 0..1
(
    moods: {
        // A flat, even delivery.
        "neutral": (
            pitch_mult: 1.0,
            range_mult: 1.0,
            rate_mult: 1.0,
            stress_len: 1.0,
            declination: 3.0,
            oq: 0.6,
            tilt: 0.25,
            breath: 0.08,
            jitter: 0.008,
            shimmer: 0.02,
            drift: 0.5,
            vibrato_depth: 0.0,
            vibrato_rate: 5.5,
            precision: 1.0,
            final_rise: 0.0,
            pause_mult: 1.0,
            burst: 1.0,
            nasal: 0.0,
        ),
        // Lower, slower, soft: talking someone down.
        "calm": (
            pitch_mult: 0.97,
            range_mult: 0.7,
            rate_mult: 0.92,
            stress_len: 1.0,
            declination: 3.5,
            oq: 0.65,
            tilt: 0.3,
            breath: 0.12,
            jitter: 0.006,
            shimmer: 0.015,
            drift: 0.4,
            vibrato_depth: 0.0,
            vibrato_rate: 5.5,
            precision: 1.0,
            final_rise: 0.0,
            pause_mult: 1.1,
            burst: 0.9,
            nasal: 0.0,
        ),
        // Clipped and a bit sharp: patience running out.
        "annoyed": (
            pitch_mult: 1.03,
            range_mult: 1.3,
            rate_mult: 1.05,
            stress_len: 1.1,
            declination: 2.5,
            oq: 0.55,
            tilt: 0.2,
            breath: 0.06,
            jitter: 0.008,
            shimmer: 0.02,
            drift: 0.5,
            vibrato_depth: 0.0,
            vibrato_rate: 5.5,
            precision: 1.1,
            final_rise: -0.5,
            pause_mult: 0.9,
            burst: 1.2,
            nasal: 0.0,
        ),
        // Higher, wider, faster, a tense bright voice and hard stops.
        "angry": (
            pitch_mult: 1.1,
            range_mult: 1.6,
            rate_mult: 1.15,
            stress_len: 1.2,
            declination: 2.0,
            oq: 0.45,
            tilt: 0.1,
            breath: 0.05,
            jitter: 0.01,
            shimmer: 0.025,
            drift: 0.6,
            vibrato_depth: 0.0,
            vibrato_rate: 5.5,
            precision: 1.2,
            final_rise: -1.0,
            pause_mult: 0.8,
            burst: 1.5,
            nasal: 0.0,
        ),
        // Angry turned up: pressed, loud, barely any pauses.
        "furious": (
            pitch_mult: 1.2,
            range_mult: 2.0,
            rate_mult: 1.3,
            stress_len: 1.3,
            declination: 1.0,
            oq: 0.38,
            tilt: 0.05,
            breath: 0.1,
            jitter: 0.02,
            shimmer: 0.04,
            drift: 0.9,
            vibrato_depth: 0.0,
            vibrato_rate: 5.5,
            precision: 1.3,
            final_rise: 0.0,
            pause_mult: 0.6,
            burst: 1.8,
            nasal: 0.0,
        ),
        // Low, narrow, slow, breathy, mumbled, sinking at the end.
        "sad": (
            pitch_mult: 0.9,
            range_mult: 0.6,
            rate_mult: 0.8,
            stress_len: 0.9,
            declination: 5.0,
            oq: 0.75,
            tilt: 0.45,
            breath: 0.5,
            jitter: 0.02,
            shimmer: 0.03,
            drift: 0.5,
            vibrato_depth: 0.0,
            vibrato_rate: 5.5,
            precision: 0.7,
            final_rise: -1.0,
            pause_mult: 1.3,
            burst: 0.6,
            nasal: 0.05,
        ),
        // High, wide and quick, rising at the end.
        "excited": (
            pitch_mult: 1.2,
            range_mult: 1.8,
            rate_mult: 1.2,
            stress_len: 1.15,
            declination: 1.0,
            oq: 0.55,
            tilt: 0.15,
            breath: 0.06,
            jitter: 0.01,
            shimmer: 0.025,
            drift: 0.7,
            vibrato_depth: 0.0,
            vibrato_rate: 5.5,
            precision: 1.1,
            final_rise: 0.5,
            pause_mult: 0.8,
            burst: 1.2,
            nasal: 0.0,
        ),
        // High, shaky, breathy, a little vibrato, unsteady pauses.
        "afraid": (
            pitch_mult: 1.25,
            range_mult: 1.4,
            rate_mult: 1.3,
            stress_len: 1.0,
            declination: 1.5,
            oq: 0.7,
            tilt: 0.2,
            breath: 0.45,
            jitter: 0.035,
            shimmer: 0.05,
            drift: 1.2,
            vibrato_depth: 0.3,
            vibrato_rate: 7.0,
            precision: 0.85,
            final_rise: 1.0,
            pause_mult: 1.2,
            burst: 0.8,
            nasal: 0.05,
        ),
        // The announcer: flat, a little nasal, slow, mechanical gaps.
        "bored": (
            pitch_mult: 1.0,
            range_mult: 0.4,
            rate_mult: 0.9,
            stress_len: 0.9,
            declination: 1.5,
            oq: 0.7,
            tilt: 0.4,
            breath: 0.15,
            jitter: 0.006,
            shimmer: 0.015,
            drift: 0.3,
            vibrato_depth: 0.0,
            vibrato_rate: 5.5,
            precision: 0.8,
            final_rise: 0.0,
            pause_mult: 1.4,
            burst: 0.7,
            nasal: 0.2,
        ),
        // Big, slow, ringing: wide pitch, vibrato on long vowels, hard falls.
        "preacher": (
            pitch_mult: 1.0,
            range_mult: 1.7,
            rate_mult: 0.85,
            stress_len: 1.3,
            declination: 4.0,
            oq: 0.5,
            tilt: 0.15,
            breath: 0.1,
            jitter: 0.01,
            shimmer: 0.025,
            drift: 0.8,
            vibrato_depth: 0.7,
            vibrato_rate: 5.2,
            precision: 1.25,
            final_rise: -1.0,
            pause_mult: 1.1,
            burst: 1.3,
            nasal: 0.0,
        ),
        // The tweakers: fast, high, rough and clipped.
        "frantic": (
            pitch_mult: 1.2,
            range_mult: 1.5,
            rate_mult: 1.4,
            stress_len: 1.0,
            declination: 1.0,
            oq: 0.5,
            tilt: 0.12,
            breath: 0.15,
            jitter: 0.03,
            shimmer: 0.05,
            drift: 1.0,
            vibrato_depth: 0.0,
            vibrato_rate: 5.5,
            precision: 0.95,
            final_rise: 0.5,
            pause_mult: 0.5,
            burst: 1.3,
            nasal: 0.0,
        ),
    },
)
